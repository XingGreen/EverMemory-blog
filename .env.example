# ============================================================
# Firefly Blog 管理后台环境变量配置
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env.local（本地开发）
#   2. 按下方说明填入实际值
#   3. 生产环境（Vercel）在项目 Settings → Environment Variables 中配置
# 完整文档参考：docs/ADMIN_MANUAL.md
# ============================================================


# ────────────────────────────────────────────────────────────
# GitHub App 配置（写入文章到仓库的凭证）
# ────────────────────────────────────────────────────────────

# GitHub App ID（纯数字）
# 位置：GitHub App Settings 页面顶部
GITHUB_APP_ID=

# GitHub 仓库所有者（用户名或组织名，不带 @）
GITHUB_OWNER=your-github-username

# GitHub 仓库名称（不带 .git 后缀）
GITHUB_REPO=your-blog-repo

# GitHub 仓库分支
# 本仓库历史原因使用 master，GitHub 新建仓库默认为 main
GITHUB_BRANCH=main

# GitHub App Installation ID（纯数字）
# 位置：App 安装页 URL 末尾的数字，如 /installations/149804847
GITHUB_INSTALLATION_ID=

# ────────────────────────────────────────────────────────────
# GitHub App 私钥（二选一即可，优先使用 GITHUB_PRIVATE_KEY）
# ────────────────────────────────────────────────────────────

# 【方式 A：Base64 编码后的 PEM】推荐用于 Vercel 等生产环境
# 生成命令：
#   node -e "console.log(require('fs').readFileSync('.key/emblog-ghapp.2026-07-29.private-key.pem').toString('base64'))"
GITHUB_PRIVATE_KEY=

# 【方式 B：私钥文件路径】仅本地开发使用
# 留空时默认查找 .key/ 和 .keys/ 目录下的 *.pem 文件
# GITHUB_PRIVATE_KEY_PATH=.key/emblog-ghapp.2026-07-29.private-key.pem


# ────────────────────────────────────────────────────────────
# 管理后台认证配置（双重锁：用户名 + 密码 + 私钥）
# ────────────────────────────────────────────────────────────

# 管理员用户名（默认 admin，可自定义）
ADMIN_USERNAME=admin

# 管理员密码（scrypt 加盐哈希，格式 scrypt$N$salt$hash）
# ⚠️ 不是明文密码！务必使用下方命令生成哈希值再填入
# 生成命令（N=131072 为默认值，耗时约 1 秒属正常）：
#   node -e "const c=require('crypto');const s=c.randomBytes(16);const h=c.scryptSync('你的密码',s,64,{N:131072,maxmem:268435456});console.log('scrypt$131072$'+s.toString('base64')+'$'+h.toString('base64'))"
ADMIN_PASSWORD=

# scrypt 成本参数 N，默认 131072(2^17，与 OWASP 推荐一致)，一般无需修改。
# 内存占用 ≈ 1024 × N 字节：N=131072 约需 128MB。
# ⚠️ 实测 N=131072 时进程峰值 RSS 约 189MiB，已超 Cloudflare Workers 的
#    128MB/isolate 硬上限（付费版同限），故本项目不支持部署到 Workers。
#    完整依据见 CLAUDE.md 的 Deployment 章节。
ADMIN_SCRYPT_N=131072

# 管理后台 JWT 签名密钥（32 字节以上的随机字符串）
# 用于签发 HttpOnly Cookie，保证登录会话安全
# 生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# 会话撤销版本号（一般无需手动配置）
# 修改管理员用户名/密码或 JWT 签名密钥时自动 +1，使所有旧会话立即失效
ADMIN_TOKEN_VER=0

# 第二密码（应急控制台 / super 空间）——可选，强烈建议配置
# 与 ADMIN_PASSWORD 同样的 scrypt 哈希格式。用它与主密码不同的密码登录，
# 即可进入「应急控制台」（踢会话 / 封 IP / 改运行时配置）。
# 可在后台「密钥配置」页填写（本地开发），或直接写入 .env.local / 平台环境变量。
# 生成命令同 ADMIN_PASSWORD（参考 docs/ADMIN_MANUAL.md），务必与主密码不同。
# ADMIN_SUPER_PASSWORD=

# 登录成功带外告警 Webhook ——可选
# 配置后，每次后台登录成功都会向该 URL POST 一条 JSON（含 text/content 及
# 结构化字段），用于 Slack/Discord/邮件网关等，以便攻击者一旦登录立即知情。
# 未配置则完全跳过。URL 形如 https://hooks.slack.com/services/...
# ADMIN_ALERT_WEBHOOK=


# ────────────────────────────────────────────────────────────
# 可选配置
# ────────────────────────────────────────────────────────────

# Cloudflare Turnstile 人机验证（登录页）
# https://dash.cloudflare.com/ → Turnstile → 创建 widget，取两个 key
#
# ⚠️ 两项必须成对配置：
#   · 都不配 → 完全跳过验证（默认，不影响任何既有部署）
#   · 只配一个 → 登录被拒。因为只配 site key 会让页面渲染出看似有效的
#     验证码，而后端根本不校验，形成虚假的安全感
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# GitHub OAuth Client ID / Secret（仅在需要"用 GitHub 账号登录"功能时配置）
# 当前管理后台采用私钥认证流程，不需要这两项
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
