# ============================================================
# Firefly Blog 管理后台环境变量配置
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env.local（本地开发）
#   2. 按下方说明填入实际值
#   3. 生产环境（Vercel）在项目 Settings → Environment Variables 中配置
# 完整文档参考：docs/ADMIN_MANUAL.md
# ============================================================


# ────────────────────────────────────────────────────────────
# GitHub App 配置（写入文章到仓库的凭证）
# ────────────────────────────────────────────────────────────

# GitHub App ID（纯数字）
# 位置：GitHub App Settings 页面顶部
GITHUB_APP_ID=

# GitHub 仓库所有者（用户名或组织名，不带 @）
GITHUB_OWNER=your-github-username

# GitHub 仓库名称（不带 .git 后缀）
GITHUB_REPO=your-blog-repo

# GitHub 仓库分支
# 本仓库历史原因使用 master，GitHub 新建仓库默认为 main
GITHUB_BRANCH=main

# GitHub App Installation ID（纯数字）
# 位置：App 安装页 URL 末尾的数字，如 /installations/149804847
GITHUB_INSTALLATION_ID=

# ────────────────────────────────────────────────────────────
# GitHub App 私钥（二选一即可，优先使用 GITHUB_PRIVATE_KEY）
# ────────────────────────────────────────────────────────────

# 【方式 A：Base64 编码后的 PEM】推荐用于 Vercel 等生产环境
# 生成命令：
#   node -e "console.log(require('fs').readFileSync('.key/emblog-ghapp.2026-07-29.private-key.pem').toString('base64'))"
GITHUB_PRIVATE_KEY=

# 【方式 B：私钥文件路径】仅本地开发使用
# 留空时默认查找 .key/ 和 .keys/ 目录下的 *.pem 文件
# GITHUB_PRIVATE_KEY_PATH=.key/emblog-ghapp.2026-07-29.private-key.pem


# ────────────────────────────────────────────────────────────
# GitHub OAuth 登录（管理员登录，复用上方同一个 GitHub App）
# ────────────────────────────────────────────────────────────
# 在 GitHub App 设置页填写 Callback URL：
#   https://你的域名/api/admin/auth/github/callback
# 本地开发如需在 localhost 登录，请在同一个 App 里再登记一条
#   http://localhost:4321/api/admin/auth/github/callback

# GitHub App 的 Client ID（形如 Iv23li…；注意与应用页顶部的 App ID 不同）
GITHUB_APP_CLIENT_ID=

# GitHub App 的 Client Secret（回调换取 token 用；泄露后立即到 GitHub 重新生成）
GITHUB_APP_CLIENT_SECRET=

# 允许登录后台的 GitHub 账号数字 id（形如 238927366，不随用户名/头像变化）
# 获取：登录 GitHub 后访问 https://api.github.com/user 查看 "id" 字段
ADMIN_GITHUB_ID=

# 可选：覆写 OAuth 回调地址；留空则按请求域名推导为
#   <origin>/api/admin/auth/github/callback
# 仅在反向代理/自定义域名导致推导错误时才需设置
# GITHUB_OAUTH_REDIRECT_URI=

# 应急登录令牌（GitHub 不可用时的备用入口）——可选
# 一段高熵随机串，登录页点击「使用应急令牌」时粘贴。
# 生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_BREAKGLASS_TOKEN=


# ────────────────────────────────────────────────────────────
# 管理后台会话配置
# ────────────────────────────────────────────────────────────

# 管理后台 JWT 签名密钥（32 字节以上的随机字符串）
# 用于签发 HttpOnly Cookie，保证登录会话安全
# 生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=

# 会话撤销版本号（一般无需手动配置）
# 修改认证相关密钥时自动 +1，使所有旧会话立即失效
ADMIN_TOKEN_VER=0

# 登录成功带外告警 Webhook ——可选
# 配置后，每次后台登录成功都会向该 URL POST 一条 JSON（含 text/content 及
# 结构化字段），用于 Slack/Discord/邮件网关等，以便攻击者一旦登录立即知情。
# 未配置则完全跳过。URL 形如 https://hooks.slack.com/services/...
# ADMIN_ALERT_WEBHOOK=


# ────────────────────────────────────────────────────────────
# 可选配置
# ────────────────────────────────────────────────────────────

# Cloudflare Turnstile 人机验证（登录页）
# https://dash.cloudflare.com/ → Turnstile → 创建 widget，取两个 key
#
# ⚠️ 两项必须成对配置：
#   · 都不配 → 完全跳过验证（默认，不影响任何既有部署）
#   · 只配一个 → 登录被拒。因为只配 site key 会让页面渲染出看似有效的
#     验证码，而后端根本不校验，形成虚假的安全感
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
