# GitHub App Configuration for Admin Dashboard
# 复制此文件为 .env.local 并填入实际值

# GitHub App ID
GITHUB_APP_ID=

# GitHub Repository Owner (用户名或组织名)
GITHUB_OWNER=your-github-username

# GitHub Repository Name
GITHUB_REPO=your-blog-repo

# GitHub Repository Branch (Github更新后默认都为 main)
GITHUB_BRANCH=main

# GitHub Installation ID
GITHUB_INSTALLATION_ID=

# 私钥文件路径 (可选，默认会查找 .key/ 目录)
# GITHUB_PRIVATE_KEY_PATH=.key/emblog-ghapp.2026-07-29.private-key.pem

# 私钥内容（Vercel 等生产环境必须配置，本地开发可留空使用文件）
# 支持纯文本或 Base64 编码，推荐 Base64 以避免换行符问题
# 生成 Base64: node -e "console.log(require('fs').readFileSync('.key/emblog-ghapp.2026-07-29.private-key.pem').toString('base64'))"
GITHUB_PRIVATE_KEY=

# GitHub App Client ID and Secret (可选，用于某些认证流程)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# 管理后台 JWT 签名密钥（生产环境必须配置，建议使用 32 字节以上的随机字符串）
# 可用以下命令生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=
