---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 从配置中获取站点开始日期
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";

// 获取所有文章
const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		// 移除代码块和内联代码后计算字数
		let text = post.body
			.replace(/```[\s\S]*?```/g, "") // 移除代码块
			.replace(/`[^`]*`/g, "") // 移除内联代码
			.replace(/\s+/g, " ") // 合并空白
			.trim();

		// 分别计算中文字符和英文字符
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
		const englishChars = text.match(/[a-zA-Z]/g) || [];

		totalWords += chineseChars.length + englishChars.length;
	}
}

// 格式化数字（添加千位分隔符）
function formatNumber(num: number): string {
	return num.toLocaleString();
}

// 获取「最后活动」时间：取每篇文章 published 与 updated 中较新的那个，再从全站所有文章里取最大值。这样新发文章和修改老文章都会刷新该字段。
const getActivityDate = (post: (typeof posts)[number]): Date => {
	const { published, updated } = post.data;
	if (updated && updated > published) return updated;
	return published;
};

const lastActivityDate = posts.reduce<Date | null>((latest, post) => {
	const current = getActivityDate(post);
	if (!latest || current > latest) return current;
	return latest;
}, null);

const lastPostDate = lastActivityDate ? lastActivityDate.toISOString() : null;

const todayText = i18n(I18nKey.today);

/** 副标题模板，如「共 {value} {unit}」 */
const summaryTemplate = i18n(I18nKey.siteStatsSummary);
const dayUnit = i18n(I18nKey.siteStatsUnitDay);
const daysAgoTemplate = i18n(I18nKey.siteStatsDaysAgo);

const buildSummary = (value: number | string, unit: string): string =>
	summaryTemplate.replace("{value}", String(value)).replace("{unit}", unit);

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		summary: buildSummary(posts.length, i18n(I18nKey.siteStatsUnitPost)),
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		summary: buildSummary(
			categories.length,
			i18n(I18nKey.siteStatsUnitCategory),
		),
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		summary: buildSummary(tags.length, i18n(I18nKey.siteStatsUnitTag)),
	},
	{
		icon: "material-symbols:text-ad-outline-rounded",
		label: i18n(I18nKey.siteStatsTotalWords),
		summary: buildSummary(
			formatNumber(totalWords),
			i18n(I18nKey.siteStatsUnitWord),
		),
	},
	{
		// 数字由客户端回填，初值占位以避免布局抖动
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		summary: buildSummary(0, i18n(I18nKey.siteStatsUnitDay)),
		id: "running-days",
	},
	{
		// 「最后活动」语义不同：直接展示「今天 / N 天前」，不套用量词模板
		icon: "mingcute:heartbeat-line",
		label: i18n(I18nKey.siteStatsLastUpdate),
		summary: "",
		id: "last-update",
	},
];
---

<WidgetLayout name={i18n(I18nKey.siteStats)} showTitle={showTitle} id="site-stats" class={className} style={style}>
  <div class="stats-grid">
    {stats.map((stat) => (
      <article class="stat-card" data-stat-card={stat.id}>
        <h4 class="stat-label">{stat.label}</h4>
        <p class="stat-summary" data-stat-id={stat.id}>{stat.summary}</p>
        <Icon is:inline name={stat.icon} class="stat-icon" aria-hidden="true" />
      </article>
    ))}
  </div>
</WidgetLayout>

<style>
  /* MD3 风格统计卡片：色调化底色 + 大圆角 + 右下角装饰图标 */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
  }

  .stat-card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    padding: 0.875rem 0.875rem 1.25rem;
    border-radius: var(--radius-large);
    background: color-mix(in oklab, var(--primary) 8%, var(--card-bg));
    transition: background 0.2s ease;
  }

  /* MD3 state layer：悬浮时底色加深 */
  .stat-card:hover {
    background: color-mix(in oklab, var(--primary) 16%, var(--card-bg));
  }

  :global(.dark) .stat-card {
    background: color-mix(in oklab, var(--primary) 14%, var(--card-bg));
  }

  :global(.dark) .stat-card:hover {
    background: color-mix(in oklab, var(--primary) 22%, var(--card-bg));
  }

  .stat-label {
    position: relative;
    z-index: 1;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--deep-text);
  }

  .stat-summary {
    position: relative;
    z-index: 1;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--content-meta);
    min-width: 0;
  }

  /* 装饰图标：右下角、低透明度，悬浮时增强 */
  .stat-icon {
    position: absolute;
    right: 0.375rem;
    bottom: 0.125rem;
    font-size: 2.125rem;
    line-height: 1;
    color: var(--primary);
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .stat-card:hover .stat-icon {
    opacity: 0.55;
  }

  /* 侧边栏极窄时退回单列，避免标题折行过碎 */
  @media (max-width: 320px) {
    .stats-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script is:inline define:vars={{ siteStartDate, lastPostDate, todayText, summaryTemplate, dayUnit, daysAgoTemplate }}>
  function updateDynamicStats() {
    const today = new Date();

    // 更新运行天数：套用与静态卡片相同的量词模板，兼容各语言语序
    const startDate = new Date(siteStartDate);
    const diffTime = Math.abs(today.getTime() - startDate.getTime());
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    const runningSummary = summaryTemplate
      .replace('{value}', diffDays.toString())
      .replace('{unit}', dayUnit);

    document.querySelectorAll('[data-stat-id="running-days"]').forEach((element) => {
      element.textContent = runningSummary;
    });

    // 更新最后活动时间
    if (lastPostDate) {
      const lastPost = new Date(lastPostDate);
      const timeSinceLastPost = Math.abs(today.getTime() - lastPost.getTime());
      const daysSinceLastUpdate = Math.floor(timeSinceLastPost / (1000 * 60 * 60 * 24));
      const lastSummary = daysSinceLastUpdate === 0
        ? todayText
        : daysAgoTemplate.replace('{days}', daysSinceLastUpdate.toString());

      document.querySelectorAll('[data-stat-id="last-update"]').forEach((element) => {
        element.textContent = lastSummary;
      });
    }
  }

  // 页面加载时更新
  updateDynamicStats();

  // 页面切换时重新更新
  document.addEventListener("swup:contentReplaced", () => {
    setTimeout(updateDynamicStats, 100);
  });
</script>
