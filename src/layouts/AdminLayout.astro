---
// 后台专用独立布局
// 与前台 MainGridLayout 不同：不含横向导航栏、小组件、页脚、悬浮控件、壁纸等前台元素
import Layout from "./Layout.astro";
import "@/styles/admin.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title, description, lang } = Astro.props;
---

<Layout title={title} description={description} lang={lang} excludeFrontendEffects>
	<!-- 后台独立布局：
	不提供 swup 容器（#swup-container 等），使后台页面完全不参与前台 SPA 导航，
	保证后台内部 hash 路由、前进/后退均交由浏览器原生处理。 -->
	<div class="admin-shell">
		<slot />
	</div>
</Layout>

<script>
	// 标记后台页面，用于给页面级滚动条套后台自定义样式（避免影响前台）
	document.documentElement.classList.add("admin-page");
</script>

<style>
	.admin-shell {
		min-height: 100vh;
		width: 100%;
		background: var(--page-bg);
	}
</style>

<style is:global>
	/* ── 后台控制面板自定义滚动条 ──
	只作用于 .admin-shell 内（后台面板/编辑器/列表/弹窗）与 admin-page 页面的根滚动条 */
	.admin-shell,
	.admin-shell * {
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.18) transparent;
	}

	.admin-shell *::-webkit-scrollbar,
	html.admin-page::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}

	.admin-shell *::-webkit-scrollbar-track,
	html.admin-page::-webkit-scrollbar-track {
		background: transparent;
	}

	.admin-shell *::-webkit-scrollbar-thumb,
	html.admin-page::-webkit-scrollbar-thumb {
		background-color: rgba(0, 0, 0, 0.18);
		border: 2px solid transparent;
		border-radius: 999px;
		background-clip: padding-box;
	}

	.admin-shell *::-webkit-scrollbar-thumb:hover,
	html.admin-page::-webkit-scrollbar-thumb:hover {
		background-color: rgba(0, 0, 0, 0.32);
	}

	.admin-shell *::-webkit-scrollbar-thumb:active,
	html.admin-page::-webkit-scrollbar-thumb:active {
		background-color: rgba(0, 0, 0, 0.45);
	}

	.dark .admin-shell,
	.dark .admin-shell * {
		scrollbar-color: rgba(255, 255, 255, 0.16) transparent;
	}

	.dark .admin-shell *::-webkit-scrollbar-thumb,
	html.dark.admin-page::-webkit-scrollbar-thumb {
		background-color: rgba(255, 255, 255, 0.16);
	}

	.dark .admin-shell *::-webkit-scrollbar-thumb:hover,
	html.dark.admin-page::-webkit-scrollbar-thumb:hover {
		background-color: rgba(255, 255, 255, 0.28);
	}

	.dark .admin-shell *::-webkit-scrollbar-thumb:active,
	html.dark.admin-page::-webkit-scrollbar-thumb:active {
		background-color: rgba(255, 255, 255, 0.42);
	}
</style>
