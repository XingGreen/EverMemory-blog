---
import AdminDashboard from "@/components/admin/AdminDashboard.svelte";
// 同 index.astro：adminConfig 直连模块，避免 barrel HMR 传播差异导致两端分裂
import { adminConfig } from "@/config/adminConfig";
import { profileConfig, siteConfig } from "@/config";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveAdminLogo } from "@/utils/admin-logo";
import { resolveAvatarUrl } from "@/utils/avatar-url";
import { canBootstrap } from "@/utils/bootstrap-mode";

// 首次配置阶段：任何后台地址都先让位给 /setup/，避免未登录的 SPA
// 在后台里空转（接口全 401）。配齐后此判定为假，后台正常渲染。
if (canBootstrap(Astro.request)) {
	return Astro.redirect("/setup/");
}

// 后台是单页应用（前端 History API 路由）：
// /admin/* 下的一切子路径（settings、articles/edit/:slug 等）都渲染同一个控制台页，
// 具体显示哪个页面由 AdminDashboard 按当前 pathname 在前端解析。
// 因此这里用不预渲染的动态兜底页承接任意子路径，避免 404。
export const prerender = false;

const title = "控制面板";
const description = `控制面板 - ${profileConfig.name}`;

const avatarUrl = resolveAvatarUrl();
const logo = await resolveAdminLogo();
---

<AdminLayout title={title} description={description}>
	<div class="admin-container" data-flush={adminConfig.sidebarFlush ? "on" : "off"}>
		<AdminDashboard
			client:load
			avatarUrl={avatarUrl}
			siteName={siteConfig.title}
			logoType={logo.type}
			logoValue={logo.value}
			logoUrl={logo.src}
			logoAlt={logo.alt}
			logoFollowTheme={logo.followTheme}
		/>
	</div>
</AdminLayout>

<style is:global>
	/* 与 admin/index.astro 保持同一基准：默认悬浮布局四周 1.5rem，紧贴模式零内距。 */
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
		min-height: calc(100dvh - 3rem);
	}

	.admin-container[data-flush="on"] {
		padding: 0;
		min-height: 100vh;
		min-height: 100dvh;
	}

	@media (max-width: 1023px) {
		.admin-container {
			padding: 1rem;
			min-height: calc(100dvh - 2rem);
		}

		.admin-container[data-flush="on"] {
			padding: 0;
			min-height: 100dvh;
		}
	}
</style>
