---
import ConsolePanel from "@/components/admin/ConsolePanel.svelte";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getAuthTokenFromRequest, verifySessionToken } from "@/utils/auth";

// 应急控制台（第二空间 / super）——控制面专属页面。
// 这里是服务端硬门禁：导航隐藏只是 UX，真正的门在此处与各控制面 API 的 requireSuperAuth。
// 未登录 → 登录页；已登录但非 super → 退回主空间控制面板。
export const prerender = false;

const token = getAuthTokenFromRequest(Astro.request);
const payload = token ? await verifySessionToken(token) : null;
if (!payload) return Astro.redirect("/admin/");
if (payload.role !== "super") return Astro.redirect("/admin/dashboard/");

const title = "应急控制台";
const description = "应急控制台 - 控制面操作";
---

<AdminLayout title={title} description={description}>
	<div class="admin-container">
		<ConsolePanel client:load />
	</div>
</AdminLayout>

<style is:global>
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
	}

	@media (max-width: 768px) {
		.admin-container {
			padding: 1rem;
		}
	}
</style>
