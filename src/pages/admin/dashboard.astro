---
import AdminDashboard from "@/components/admin/AdminDashboard.svelte";
import { profileConfig, siteConfig } from "@/config";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveAdminLogo } from "@/utils/admin-logo";
import { resolveAvatarUrl } from "@/utils/avatar-url";

const title = "控制面板";
const description = `控制面板 - ${profileConfig.name}`;

const avatarUrl = resolveAvatarUrl();
const logo = await resolveAdminLogo();
---

<AdminLayout title={title} description={description}>
	<div class="admin-container">
		<AdminDashboard
			client:load
			avatarUrl={avatarUrl}
			siteName={siteConfig.title}
			logoType={logo.type}
			logoValue={logo.value}
			logoUrl={logo.src}
			logoAlt={logo.alt}
			logoFollowTheme={logo.followTheme}
		/>
	</div>
</AdminLayout>

<style is:global>
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
	}

	@media (max-width: 768px) {
		.admin-container {
			padding: 1rem;
		}
	}
</style>
