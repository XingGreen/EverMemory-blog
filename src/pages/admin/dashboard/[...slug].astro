---
import AdminDashboard from "@/components/admin/AdminDashboard.svelte";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { profileConfig } from "@/config";
import { resolveAvatarUrl } from "@/utils/avatar-url";

// 后台是单页应用（前端 History API 路由）：
// /admin/dashboard/* 下的一切子路径（settings、articles/edit/:slug 等）都渲染同一个控制台页，
// 具体显示哪个页面由 AdminDashboard 按当前 pathname 在前端解析。
// 因此这里用不预渲染的动态兜底页承接任意子路径，避免 404。
export const prerender = false;

const title = "控制面板";
const description = `控制面板 - ${profileConfig.name}`;

const avatarUrl = resolveAvatarUrl();
---

<AdminLayout title={title} description={description}>
	<div class="admin-container">
		<AdminDashboard client:load avatarUrl={avatarUrl} />
	</div>
</AdminLayout>

<style is:global>
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
	}

	@media (max-width: 768px) {
		.admin-container {
			padding: 1rem;
		}
	}
</style>