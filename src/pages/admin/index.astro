---
import AdminDashboard from "@/components/admin/AdminDashboard.svelte";
import AdminEntryVeil from "@/components/admin/AdminEntryVeil.svelte";
import { profileConfig, siteConfig } from "@/config";
// adminConfig 与 AdminDashboard 用同一条 import 路径（不走 config barrel）：
// vite 对 barrel 链路的 HMR 传播与直连模块不同步，会出现 SSR 端读到旧值、
// 客户端读到新值的两端分裂（实测：侧栏直角但容器仍有内距的混合态）。
import { adminConfig } from "@/config/adminConfig";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveAdminLogo } from "@/utils/admin-logo";
import { resolveAdminAvatarUrl } from "@/utils/avatar-url";
import { canBootstrap } from "@/utils/bootstrap-mode";

// 首次配置阶段：后台首页也让位给 /setup/，与 [...slug] 兜底页保持一致。
if (canBootstrap(Astro.request)) {
	return Astro.redirect("/setup/");
}

const title = "控制面板";
const description = `控制面板 - ${profileConfig.name}`;

const avatarUrl = resolveAdminAvatarUrl();
const logo = await resolveAdminLogo();
---

<AdminLayout title={title} description={description}>
	<AdminEntryVeil client:load />
	<div class="admin-container" data-flush={adminConfig.sidebarFlush ? "on" : "off"}>
		<AdminDashboard
			client:load
			avatarUrl={avatarUrl}
			siteName={siteConfig.title}
			logoType={logo.type}
			logoValue={logo.value}
			logoUrl={logo.src}
			logoAlt={logo.alt}
			logoFollowTheme={logo.followTheme}
		/>
	</div>
</AdminLayout>

<style is:global>
	/* 默认（悬浮卡片布局）：容器四周 1.5rem，高度为视口减去上下内距。
	   紧贴模式（data-flush="on"）：容器零内距，侧栏贴左缘全高，
	   内容区的画布空隙改由 .admin-main 的 margin 提供（AdminDashboard 内）。 */
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
		/* dvh 跟随浏览器地址栏收放，避免手机上下拖动时高度跳变。
		   不支持的浏览器沿用上一行的 vh 值。 */
		min-height: calc(100dvh - 3rem);
	}

	.admin-container[data-flush="on"] {
		padding: 0;
		min-height: 100vh;
		min-height: 100dvh;
	}

	/* 断点必须与 .admin-layout 的移动端覆盖（1023px）对齐：
	   两处内边距与高度基准不一致时，1024 边缘附近会出现纵向溢出。 */
	@media (max-width: 1023px) {
		.admin-container {
			padding: 1rem;
			min-height: calc(100dvh - 2rem);
		}

		.admin-container[data-flush="on"] {
			padding: 0;
			min-height: 100dvh;
		}
	}
</style>
