---
import AdminDashboard from "@/components/admin/AdminDashboard.svelte";
import { profileConfig, siteConfig } from "@/config";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveAdminLogo } from "@/utils/admin-logo";
import { resolveAvatarUrl } from "@/utils/avatar-url";

const title = "控制面板";
const description = `控制面板 - ${profileConfig.name}`;

const avatarUrl = resolveAvatarUrl();
const logo = await resolveAdminLogo();
---

<AdminLayout title={title} description={description}>
	<div class="admin-container">
		<AdminDashboard
			client:load
			avatarUrl={avatarUrl}
			siteName={siteConfig.title}
			logoType={logo.type}
			logoValue={logo.value}
			logoUrl={logo.src}
			logoAlt={logo.alt}
			logoFollowTheme={logo.followTheme}
		/>
	</div>
</AdminLayout>

<style is:global>
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
		/* dvh 跟随浏览器地址栏收放，避免手机上下拖动时高度跳变。
		   不支持的浏览器沿用上一行的 vh 值。 */
		min-height: calc(100dvh - 3rem);
	}

	/* 断点必须与 .admin-layout 的移动端覆盖（1023px）对齐：
	   两处内边距与高度基准不一致时，1024 边缘附近会多出 1rem 的纵向溢出。 */
	@media (max-width: 1023px) {
		.admin-container {
			padding: 1rem;
			min-height: calc(100dvh - 2rem);
		}
	}
</style>
