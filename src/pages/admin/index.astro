---
import AdminDashboard from "@/components/admin/AdminDashboard.svelte";
import { profileConfig, siteConfig } from "@/config";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveAdminLogo } from "@/utils/admin-logo";
import { resolveAvatarUrl } from "@/utils/avatar-url";
import { canBootstrap } from "@/utils/bootstrap-mode";

// 首次配置阶段：后台首页也让位给 /setup/，与 [...slug] 兜底页保持一致。
if (canBootstrap(Astro.request)) {
	return Astro.redirect("/setup/");
}

const title = "控制面板";
const description = `控制面板 - ${profileConfig.name}`;

const avatarUrl = resolveAvatarUrl();
const logo = await resolveAdminLogo();
---

<AdminLayout title={title} description={description}>
	<div class="admin-container">
		<AdminDashboard
			client:load
			avatarUrl={avatarUrl}
			siteName={siteConfig.title}
			logoType={logo.type}
			logoValue={logo.value}
			logoUrl={logo.src}
			logoAlt={logo.alt}
			logoFollowTheme={logo.followTheme}
		/>
	</div>
</AdminLayout>

<style is:global>
	/* 紧贴模式：后台与屏幕边缘零间距（对齐前台导航栏的贴边语言）。
	   侧边栏自身贴左缘、全高；高度基准因此从「视口减双倍内距」改为整视口。 */
	.admin-container {
		padding: 0;
		min-height: 100vh;
		/* dvh 跟随浏览器地址栏收放，避免手机上下拖动时高度跳变。
		   不支持的浏览器沿用上一行的 vh 值。 */
		min-height: 100dvh;
	}

	/* 断点必须与 .admin-layout 的移动端覆盖（1023px）对齐：
	   两处内边距与高度基准不一致时，1024 边缘附近会出现纵向溢出。 */
	@media (max-width: 1023px) {
		.admin-container {
			padding: 0;
			min-height: 100dvh;
		}
	}
</style>
