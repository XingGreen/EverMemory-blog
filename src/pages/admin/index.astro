---
import AdminDashboard from "@/components/admin/AdminDashboard.svelte";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { profileConfig } from "@/config";

const title = "控制面板";
const description = `控制面板 - ${profileConfig.name}`;

// 解析头像 URL：src 目录的图片需要在构建时用 import.meta.glob 解析为构建后路径
let avatarUrl = profileConfig.avatar || "";
if (avatarUrl && !avatarUrl.startsWith("http") && !avatarUrl.startsWith("/")) {
	const images = import.meta.glob("/src/assets/images/*.{avif,webp,jpg,jpeg,png,gif,svg}", {
		eager: true,
		query: "?url",
		import: "default",
	});
	avatarUrl = (images[`/src/${avatarUrl}`] as string) || avatarUrl;
}
---

<AdminLayout title={title} description={description}>
	<div class="admin-container">
		<!-- 预渲染 loading 骨架，防止 Svelte 水合前白屏（FOUC） -->
		<div id="admin-skeleton" class="admin-skeleton">
			<div class="skeleton-card">
				<div class="skeleton-avatar"></div>
				<div class="skeleton-line w-60"></div>
				<div class="skeleton-line w-40"></div>
				<div class="skeleton-input"></div>
				<div class="skeleton-input"></div>
				<div class="skeleton-input tall"></div>
				<div class="skeleton-btn"></div>
			</div>
		</div>
		<AdminDashboard client:load avatarUrl={avatarUrl} />
	</div>
</AdminLayout>

<style is:global>
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
	}

	@media (max-width: 768px) {
		.admin-container {
			padding: 1rem;
		}
	}

	/* ── Loading 骨架（Svelte 水合后由组件自身隐藏） ── */
	.admin-skeleton {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem 0;
	}

	/* Svelte 水合后隐藏骨架 */
	.admin-skeleton:has(+ .svelte-component) {
		display: none;
	}

	.skeleton-card {
		padding: 2.5rem 2rem;
		width: 100%;
		max-width: 400px;
		background: var(--card-bg);
		border: 1px solid var(--line-divider);
		border-radius: var(--radius-large);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.skeleton-avatar {
		width: 4rem;
		height: 4rem;
		border-radius: 50%;
		background: var(--line-divider);
		animation: skeleton-pulse 1.5s ease-in-out infinite;
	}

	.skeleton-line {
		height: 0.875rem;
		border-radius: var(--radius-sm);
		background: var(--line-divider);
		animation: skeleton-pulse 1.5s ease-in-out infinite;
	}

	.skeleton-line.w-60 {
		width: 60%;
	}
	.skeleton-line.w-40 {
		width: 40%;
	}

	.skeleton-input {
		width: 100%;
		height: 2.75rem;
		border-radius: var(--radius-md);
		background: var(--line-divider);
		animation: skeleton-pulse 1.5s ease-in-out infinite;
	}

	.skeleton-input.tall {
		height: 5rem;
	}

	.skeleton-btn {
		width: 100%;
		height: 2.75rem;
		border-radius: var(--radius-md);
		background: var(--line-divider);
		animation: skeleton-pulse 1.5s ease-in-out infinite;
	}

	@keyframes skeleton-pulse {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.5;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.skeleton-avatar,
		.skeleton-line,
		.skeleton-input,
		.skeleton-btn {
			animation: none;
		}
	}
</style>
