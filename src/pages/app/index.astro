---
import { Icon } from "astro-icon/components";
import AppCard from "@/components/pages/app/AppCard.astro";
import { appConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.app) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.app);
const description = i18n(I18nKey.appDescription);

const apps = appConfig.apps;
const allTags = [...new Set(apps.flatMap((s) => s.tags || []))].sort();
const allPlatforms = [...new Set(apps.flatMap((s) => s.platform || []))].sort();

// 运行时覆盖脚本用到的 i18n 文案（构建期注入，避免硬编码）
const runtimeLabels = {
	all: i18n(I18nKey.all),
	appFree: i18n(I18nKey.appFree),
	appFreemium: i18n(I18nKey.appFreemium),
	appPaid: i18n(I18nKey.appPaid),
	appVisitSite: i18n(I18nKey.appVisitSite),
	appSourceCode: i18n(I18nKey.appSourceCode),
	appNoLink: i18n(I18nKey.appNoLink),
	searchNoResults: i18n(I18nKey.searchNoResults),
};
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<div class="mb-4">
				<div class="flex items-center gap-3 mb-3">
					<div
						class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
					>
						<Icon is:inline name="material-symbols:apps" class="text-[1.5rem]" />
					</div>
					<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
						{title}
					</div>
				</div>
				{description && (
					<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
						{description}
					</p>
				)}
			</div>

			{apps.length > 0 && (
				<app-filter class="mb-6">
					<div class="relative mb-3">
						<Icon is:inline
							name="material-symbols:search"
							class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 dark:text-neutral-500 text-lg pointer-events-none"
						/>
						<input
							type="text"
							data-search
							placeholder={i18n(I18nKey.searchApp)}
							class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm"
						/>
					</div>
					<div class="space-y-4">
						{allTags.length > 0 && (
							<div>
								<div class="text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-2">
									{i18n(I18nKey.category)}
								</div>
								<div class="flex flex-wrap gap-2" id="app-tags">
									<button
										data-tag="all"
										class="btn-regular px-3 py-1.5 rounded-lg bg-(--primary) text-white hover:bg-(--primary) transition-colors duration-200 text-sm font-medium"
									>
										{i18n(I18nKey.all)}
									</button>
									{allTags.map((tag) => (
										<button
											data-tag={tag}
											class="btn-regular px-3 py-1.5 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors duration-200 text-sm font-medium"
										>
											{tag}
										</button>
									))}
								</div>
							</div>
						)}
						{allPlatforms.length > 0 && (
							<div>
								<div class="text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-2">
									{i18n(I18nKey.platform)}
								</div>
								<div class="flex flex-wrap gap-2" id="app-platforms">
									<button
										data-platform="all"
										class="btn-regular px-3 py-1.5 rounded-lg bg-(--primary) text-white hover:bg-(--primary) transition-colors duration-200 text-sm font-medium"
									>
										{i18n(I18nKey.all)}
									</button>
									{allPlatforms.map((platform) => (
										<button
											data-platform={platform}
											class="btn-regular px-3 py-1.5 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors duration-200 text-sm font-medium"
										>
											{platform}
										</button>
									))}
								</div>
							</div>
						)}
					</div>
				</app-filter>
			)}

			{apps.length > 0 ? (
				<>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4" id="app-grid">
						{apps.map((item) => (
							<AppCard
								name={item.name}
								description={item.description}
								tags={item.tags}
								visitUrl={item.visitUrl}
								sourceCode={item.sourceCode}
								icon={item.icon}
								platform={item.platform}
								priceType={item.priceType}
							/>
						))}
					</div>
					<div class="app-empty hidden flex-col items-center justify-center py-12 text-neutral-400 dark:text-neutral-500">
						<Icon is:inline name="material-symbols:search-off-rounded" class="text-4xl mb-3" />
						<div class="text-sm">{i18n(I18nKey.searchNoResults)}</div>
					</div>
				</>
			) : (
				<div class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
					<Icon is:inline name="material-symbols:apps" class="text-6xl mb-4 opacity-50" />
					<p class="text-lg">{i18n(I18nKey.appNoItems)}</p>
				</div>
			)}
		</div>
	</div>

	<div class="mt-4 flex w-full rounded-(--radius-large) overflow-hidden relative">
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<div class="flex items-center gap-3 mb-4">
				<div class="h-8 w-8 rounded-lg bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600 dark:text-amber-400">
					<Icon is:inline name="material-symbols:warning-rounded" class="text-[1.5rem]" />
				</div>
				<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">第三方应用声明</div>
			</div>
			<div class="space-y-3 text-sm text-neutral-600 dark:text-neutral-400">
				<div class="flex gap-3">
					<span class="flex-shrink-0 w-5 h-5 rounded-full bg-(--primary)/10 text-(--primary) flex items-center justify-center text-xs font-medium">1</span>
					<span><strong>链接政策：</strong>本站仅提供有官方网站的应用链接。无官网或官网无法访问的应用，仅提供名称及功能描述，不附任何下载链接。</span>
				</div>
				<div class="flex gap-3">
					<span class="flex-shrink-0 w-5 h-5 rounded-full bg-(--primary)/10 text-(--primary) flex items-center justify-center text-xs font-medium">2</span>
					<span><strong>来源说明：</strong>官网链接指向应用开发者自行维护的页面，本站不存储、不分发、不修改任何应用内容。</span>
				</div>
				<div class="flex gap-3">
					<span class="flex-shrink-0 w-5 h-5 rounded-full bg-(--primary)/10 text-(--primary) flex items-center justify-center text-xs font-medium">3</span>
					<span><strong>安全提示：</strong>下载和使用前请自行进行病毒扫描及安全性评估。本站不对应用的安全性、完整性、合法性做任何担保。</span>
				</div>
				<div class="flex gap-3">
					<span class="flex-shrink-0 w-5 h-5 rounded-full bg-(--primary)/10 text-(--primary) flex items-center justify-center text-xs font-medium">4</span>
					<span><strong>责任限制：</strong>因使用第三方应用导致的任何损失，请直接联系应用提供方或权利方，本站不承担法律责任。</span>
				</div>
				<div class="flex gap-3">
					<span class="flex-shrink-0 w-5 h-5 rounded-full bg-(--primary)/10 text-(--primary) flex items-center justify-center text-xs font-medium">5</span>
					<span><strong>内容时效：</strong>应用信息可能存在更新滞后，请以官方最新说明为准。</span>
				</div>
			</div>
		</div>
	</div>

	<script slot="head" is:inline>
		if (!customElements.get("app-filter")) {
			class AppFilter extends HTMLElement {
				selectedTag = "all";
				selectedPlatform = "all";

				constructor() {
					super();
				}

				connectedCallback() {
					this.addEventListener("click", this.handleClick);
					// 使用事件委托绑定 input，避免自定义元素升级时子节点尚未解析而丢失监听
					this.addEventListener("input", this.handleInput);
				}

				disconnectedCallback() {
					this.removeEventListener("click", this.handleClick);
					this.removeEventListener("input", this.handleInput);
				}

				handleInput(e) {
					if (e.target.matches("[data-search]")) {
						this.applyFilters();
					}
				}

				handleClick(e) {
					const target = e.target;
					const button = target.closest("button");
					if (!button) return;

					if ("tag" in button.dataset) {
						this.selectedTag = button.dataset.tag;
						const tagFilters = this.querySelectorAll("[data-tag]");
						tagFilters.forEach((f) => {
							f.classList.remove("bg-(--primary)", "text-white");
							f.classList.remove("hover:bg-(--primary)");
							f.classList.add("bg-(--btn-regular-bg)", "text-(--btn-content)");
							f.classList.add("hover:bg-(--btn-regular-bg-hover)");

							if (f === button) {
								f.classList.remove("bg-(--btn-regular-bg)", "text-(--btn-content)");
								f.classList.remove("hover:bg-(--btn-regular-bg-hover)");
								f.classList.add("bg-(--primary)", "text-white");
								f.classList.add("hover:bg-(--primary)");
							}
						});
					} else if ("platform" in button.dataset) {
						this.selectedPlatform = button.dataset.platform;
						const platformFilters = this.querySelectorAll("[data-platform]");
						platformFilters.forEach((f) => {
							f.classList.remove("bg-(--primary)", "text-white");
							f.classList.remove("hover:bg-(--primary)");
							f.classList.add("bg-(--btn-regular-bg)", "text-(--btn-content)");
							f.classList.add("hover:bg-(--btn-regular-bg-hover)");

							if (f === button) {
								f.classList.remove("bg-(--btn-regular-bg)", "text-(--btn-content)");
								f.classList.remove("hover:bg-(--btn-regular-bg-hover)");
								f.classList.add("bg-(--primary)", "text-white");
								f.classList.add("hover:bg-(--primary)");
							}
						});
					}

					this.applyFilters();
				}

				applyFilters() {
					const container = this.closest(".card-base");
					if (!container) return;

					const input = this.querySelector("[data-search]");
					const query = (input?.value || "").toLowerCase().trim();
					const cards = container.querySelectorAll(".app-card");

					let hasVisible = false;

					cards.forEach((card) => {
						const cardEl = card;
						const tags = (cardEl.dataset.tags || "").split(",");
						const platforms = (cardEl.dataset.platform || "").split(",");
						const name = (cardEl.querySelector("h3")?.textContent || "").toLowerCase();
						const desc = (cardEl.querySelector("p")?.textContent || "").toLowerCase();

						const tagMatch =
							this.selectedTag === "all" ||
							(this.selectedTag && tags.includes(this.selectedTag));
						const platformMatch =
							this.selectedPlatform === "all" ||
							(this.selectedPlatform && platforms.includes(this.selectedPlatform));
						const searchMatch =
							!query ||
							name.includes(query) ||
							desc.includes(query) ||
							tags.some((t) => t.toLowerCase().includes(query));

						if (tagMatch && platformMatch && searchMatch) {
							cardEl.style.display = "";
							cardEl.classList.add("animate-fade-in-up");
							hasVisible = true;
						} else {
							cardEl.style.display = "none";
							cardEl.classList.remove("animate-fade-in-up");
						}
					});

					const emptyEl = container.querySelector(".app-empty");
					if (emptyEl) {
						emptyEl.classList.toggle("hidden", hasVisible);
						emptyEl.classList.toggle("flex", !hasVisible);
					}
				}
			}
			customElements.define("app-filter", AppFilter);
		}
	</script>

	<script is:inline define:vars={{ runtimeLabels }}>
		(() => {
			// 软件推荐运行时覆盖：后台保存 apps 覆盖层后，立即重建列表与筛选按钮（无需重建站点）
			const runtimeApi = "/api/runtime-config/";
			let cached = null;

			function esc(s) {
				return String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({
					"&": "&amp;",
					"<": "&lt;",
					">": "&gt;",
					'"': "&quot;",
				})[c]);
			}

			function priceBadge(item) {
				if (!item.priceType) return "";
				const cls =
					item.priceType === "free"
						? "bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400"
						: item.priceType === "freemium"
						  ? "bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400"
						  : "bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400";
				const label =
					item.priceType === "free"
						? runtimeLabels.appFree
						: item.priceType === "freemium"
						  ? runtimeLabels.appFreemium
						  : runtimeLabels.appPaid;
				return `<span class="text-xs px-2 py-0.5 rounded-full font-medium ${cls}">${esc(
					label,
				)}</span>`;
			}

			function filterButtonHtml(value, key, isAll) {
				const active =
					"btn-regular px-3 py-1.5 rounded-lg bg-(--primary) text-white hover:bg-(--primary) transition-colors duration-200 text-sm font-medium";
				const normal =
					"btn-regular px-3 py-1.5 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) hover:bg-(--btn-regular-bg-hover) transition-colors duration-200 text-sm font-medium";
				return `<button data-${key}="${isAll ? "all" : esc(value)}" class="${isAll ? active : normal}">${esc(isAll ? runtimeLabels.all : value)}</button>`;
			}

			function cardHtml(item) {
				const iconUrl =
					item.icon &&
					(item.icon.startsWith("http://") || item.icon.startsWith("https://"));
				const platforms = (item.platform || [])
					.map(
						(p) =>
							`<span class="text-[0.65rem] px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">${esc(p)}</span>`,
					)
					.join("");
				const tags = (item.tags || [])
					.slice(0, 4)
					.map(
						(t) =>
							`<span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-(--primary)/5 text-(--primary) border border-(--primary)/10">${esc(t)}</span>`,
					)
					.join("");
				const links = [];
				if (item.visitUrl) {
					links.push(
						`<a href="${esc(item.visitUrl)}" target="_blank" rel="noopener noreferrer" class="flex-[9] inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg btn-regular text-sm font-medium">${esc(runtimeLabels.appVisitSite)}</a>`,
					);
					if (item.sourceCode) {
						links.push(
							`<a href="${esc(item.sourceCode)}" target="_blank" rel="noopener noreferrer" class="flex-[1] inline-flex items-center justify-center px-3 py-2 rounded-lg btn-regular text-sm font-medium">${esc(runtimeLabels.appSourceCode)}</a>`,
						);
					}
				} else if (item.sourceCode) {
					links.push(
						`<a href="${esc(item.sourceCode)}" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg btn-regular text-sm font-medium">${esc(runtimeLabels.appSourceCode)}</a>`,
					);
				} else {
					links.push(
						`<span class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 text-sm cursor-not-allowed">${esc(runtimeLabels.appNoLink)}</span>`,
					);
				}
				return `
				<div class="app-card group relative block overflow-hidden rounded-xl border border-(--line-divider) hover:border-(--primary) hover:bg-(--card-bg) transition-all duration-300 hover:shadow-lg" data-tags="${esc((item.tags || []).join(","))}" data-platform="${esc((item.platform || []).join(","))}">
					<div class="absolute inset-0 bg-(--primary) opacity-0 group-hover:opacity-5 transition-opacity duration-300 pointer-events-none"></div>
					<div class="relative p-5">
						<div class="flex items-start gap-4">
							<div class="relative w-16 h-16 flex-shrink-0 rounded-xl overflow-hidden bg-zinc-100 dark:bg-zinc-800 border border-black/5 dark:border-white/5 group-hover:scale-105 transition-transform duration-300 flex items-center justify-center">
								${iconUrl ? `<img src="${esc(item.icon)}" alt="${esc(item.name)}" class="w-full h-full object-contain" loading="lazy">` : '<span class="text-2xl">📦</span>'}
							</div>
							<div class="flex-1 min-w-0">
								<div class="flex items-center justify-between gap-2 mb-1">
									<h3 class="font-bold text-lg text-neutral-900 dark:text-neutral-100 line-clamp-1">${esc(item.name)}</h3>
									${priceBadge(item)}
								</div>
								${item.description ? `<p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed mb-3" title="${esc(item.description)}">${esc(item.description)}</p>` : ""}
								<div class="flex flex-wrap items-center gap-2">${platforms}</div>
								${item.tags && item.tags.length ? `<div class="flex flex-wrap gap-1 mt-3">${tags}</div>` : ""}
							</div>
						</div>
						<div class="relative mt-4 flex gap-2 px-1">${links.join("")}</div>
					</div>
				</div>`;
			}

			function renderApps(apps) {
				const grid = document.getElementById("app-grid");
				if (!grid) return;

				const tags = [...new Set((apps || []).flatMap((s) => s.tags || []))].sort();
				const tagBox = document.getElementById("app-tags");
				if (tagBox) {
					tagBox.innerHTML =
						filterButtonHtml("", "tag", true) +
						tags.map((t) => filterButtonHtml(t, "tag", false)).join("");
				}
				const platforms = [...new Set((apps || []).flatMap((s) => s.platform || []))].sort();
				const platBox = document.getElementById("app-platforms");
				if (platBox) {
					platBox.innerHTML =
						filterButtonHtml("", "platform", true) +
						platforms.map((p) => filterButtonHtml(p, "platform", false)).join("");
				}

				if (!apps || apps.length === 0) {
					grid.innerHTML = `<div class="col-span-full flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500 text-sm">${esc(runtimeLabels.searchNoResults)}</div>`;
					return;
				}
				grid.innerHTML = apps.map(cardHtml).join("");
			}

			async function apply() {
				if (cached) {
					renderApps(cached);
					return;
				}
				try {
					const res = await fetch(runtimeApi);
					if (!res.ok) return;
					const data = await res.json();
					cached = Array.isArray(data && data.app && data.app.apps)
						? data.app.apps
						: null;
					if (cached) renderApps(cached);
				} catch {
					// 网络异常等保持 SSR 默认渲染
				}
			}

			document.addEventListener("astro:page-load", () => apply());
			apply();
		})();
	</script>
</MainGridLayout>
