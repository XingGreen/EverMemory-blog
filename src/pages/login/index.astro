---
import LoginGate from "@/components/admin/LoginGate.svelte";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { resolveAvatarUrl } from "@/utils/avatar-url";
import { canBootstrap } from "@/utils/bootstrap-mode";

// 首次配置是全站唯一入口：还没配好登录所需密钥时，登录页也让位给 /setup/。
// 配置齐了（或生产/非本机）canBootstrap 为假，登录页正常显示。
export const prerender = false;

if (canBootstrap(Astro.request)) {
	return Astro.redirect("/setup/");
}

const title = "控制面板";
const description = "登录后台管理";

const avatarUrl = resolveAvatarUrl();
---

<AdminLayout title={title} description={description}>
	<div class="admin-container">
		<LoginGate client:load avatarUrl={avatarUrl} />
	</div>
</AdminLayout>

<style is:global>
	.admin-container {
		padding: 1.5rem;
		min-height: calc(100vh - 3rem);
	}

	@media (max-width: 768px) {
		.admin-container {
			padding: 1rem;
		}
	}
</style>
