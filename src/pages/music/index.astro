---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";

if (!siteConfig.pages.music) {
	return Astro.redirect("/404/");
}

const buildTime = formatDateI18nWithTime(new Date());

const musicConfig = siteConfig.music;
const NETEASE_USER_ID = musicConfig?.userId;
const MODE = (musicConfig?.mode || "dynamic") as "static" | "dynamic";

const isConfigured = !!NETEASE_USER_ID;

interface Playlist {
	id: string | number;
	name: string;
	coverImgUrl?: string;
	cover?: string;
	description?: string;
	creator?: {
		nickname?: string;
		userId?: string | number;
		id?: string | number;
	};
	trackCount?: number;
	tracks?: Array<{
		id: string | number;
		name: string;
		artist: string;
		album: string;
		duration?: number;
	}>;
	playCount?: number;
	subscribed?: boolean;
}

const apis = [
	`https://apis.netstart.cn/music/user/playlist?uid=${NETEASE_USER_ID}`,
	`https://music.163.com/api/user/playlist/?uid=${NETEASE_USER_ID}`,
	`https://api.i-meto.com/meting/api?server=netease&type=playlist&id=${NETEASE_USER_ID}`,
];

async function fetchPlaylists(userId: string) {
	if (!userId) {
		return { myPlaylists: [], subscribedPlaylists: [] };
	}
	const userIdStr = userId.toString();
	for (const url of apis) {
		try {
			const response = await fetch(url, {
				headers: {
					"User-Agent":
						"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
					Referer: "https://music.163.com/",
				},
			});
			const data = await response.json();

			if (data.code === 200 && data.playlist) {
				if (data.subscribedPlaylist && Array.isArray(data.subscribedPlaylist)) {
					return {
						myPlaylists: (data.playlist as Playlist[]).filter((p) => {
							const creatorId =
								p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId === userIdStr;
						}),
						subscribedPlaylists: data.subscribedPlaylist as Playlist[],
					};
				}
				return {
					myPlaylists: (data.playlist as Playlist[]).filter((p) => {
						const creatorId =
							p.creator?.userId?.toString() || p.creator?.id?.toString();
						return creatorId === userIdStr;
					}),
					subscribedPlaylists: (data.playlist as Playlist[]).filter((p) => {
						const creatorId =
							p.creator?.userId?.toString() || p.creator?.id?.toString();
						return creatorId !== userIdStr;
					}),
				};
			}
		} catch (error) {
			console.error(`[Music] API request failed: ${url}`, error);
		}
	}
	return { myPlaylists: [], subscribedPlaylists: [] };
}

async function fetchPlaylistDetail(playlistId: string | number) {
	const detailApis = [
		`https://api.i-meto.com/meting/api?server=netease&type=playlist&id=${playlistId}&limit=1000`,
		`https://music.163.com/api/playlist/detail?id=${playlistId}`,
	];

	for (const url of detailApis) {
		try {
			const response = await fetch(url, {
				headers: {
					"User-Agent":
						"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
					Referer: "https://music.163.com/",
				},
			});
			const data = await response.json();
			if (data && data.tracks) {
				return data;
			}
		} catch (error) {
			console.error(`[Music] Detail API request failed: ${url}`, error);
		}
	}
	return null;
}

let staticPlaylists = { myPlaylists: [], subscribedPlaylists: [] } as {
	myPlaylists: Playlist[];
	subscribedPlaylists: Playlist[];
};
let fetchFailed = false;

if (!isConfigured) {
	console.log("[Music] ⚠️ 未配置网易云音乐用户ID，跳过数据获取");
} else if (MODE === "static") {
	console.log("[Music] 🌐 从 API 获取数据（static 模式）");
	try {
		const result = await fetchPlaylists(NETEASE_USER_ID!);
		staticPlaylists = result;

		const allPlaylists = [...result.myPlaylists, ...result.subscribedPlaylists];
		const detailPromises = allPlaylists.map((p) => fetchPlaylistDetail(p.id));
		const details = await Promise.all(detailPromises);

		details.forEach((detail, index) => {
			if (detail && detail.tracks) {
				allPlaylists[index].trackCount = detail.tracks.length;
				allPlaylists[index].tracks = detail.tracks;
			}
		});

		staticPlaylists = {
			myPlaylists: allPlaylists.filter((p) => {
				const creatorId =
					p.creator?.userId?.toString() || p.creator?.id?.toString();
				const userIdStr = NETEASE_USER_ID?.toString();
				return userIdStr && creatorId === userIdStr;
			}),
			subscribedPlaylists: allPlaylists.filter((p) => {
				const creatorId =
					p.creator?.userId?.toString() || p.creator?.id?.toString();
				const userIdStr = NETEASE_USER_ID?.toString();
				return userIdStr && creatorId !== userIdStr;
			}),
		};
	} catch (error) {
		console.error("[Music] 获取数据失败:", error);
		fetchFailed = true;
	}
}
---

<MainGridLayout title={i18n(I18nKey.music)} description={i18n(I18nKey.musicDescription)}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
			<div class="border-b border-(--line-divider) pb-6 mb-6">
				<div class="flex items-center gap-3 mb-3">
					<div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
						<Icon is:inline name="material-symbols:music-note" class="text-[1.5rem]"></Icon>
					</div>
					<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
						{i18n(I18nKey.music)}
					</div>
				</div>
				<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
					{i18n(I18nKey.musicDescription)}
				</p>
				<div class="flex items-center gap-2.5 text-xs text-neutral-500 dark:text-neutral-500 mt-3">
					<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-(--btn-regular-bg) text-(--btn-content)">
						<Icon is:inline name="material-symbols:cloud" class="w-3.5 h-3.5" />
						{MODE === "static" ? i18n(I18nKey.musicStaticMode) : i18n(I18nKey.musicDynamicMode)}
					</span>
					{MODE === "static" ? (
						<span>{i18n(I18nKey.musicBuildTime)} {buildTime}</span>
					) : (
						<span id="updateTime">{i18n(I18nKey.musicUpdateTime)} --</span>
					)}
				</div>
			</div>

		{!isConfigured ? (
			<div class="text-center py-16">
				<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
					<Icon is:inline name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
				</div>
				<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
					{i18n(I18nKey.musicNotConfigured)}
				</h2>
				<p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
					{i18n(I18nKey.musicNotConfiguredDesc)}
				</p>
				<code class="inline-block px-3 py-1 bg-(--bg-secondary) rounded-lg text-sm text-(--btn-content)">
					siteConfig.music.userId
				</code>
			</div>
		) : MODE === "dynamic" ? (
			<>
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
					<div class="bg-(--bg-secondary) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
						<div class="flex items-center gap-2 sm:gap-3">
							<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-(--primary)/10 flex items-center justify-center shrink-0">
								<Icon is:inline name="material-symbols:music-note" class="text-[1rem] sm:text-[1.25rem] text-(--primary)" />
							</div>
							<div class="min-w-0">
								<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalPlaylists)}</div>
								<div id="stats-playlists" class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">--</div>
							</div>
						</div>
					</div>
					<div class="bg-(--bg-secondary) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
						<div class="flex items-center gap-2 sm:gap-3">
							<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-purple-500/10 flex items-center justify-center shrink-0">
								<Icon is:inline name="material-symbols:queue-music-rounded" class="text-[1rem] sm:text-[1.25rem] text-purple-500" />
							</div>
							<div class="min-w-0">
								<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalTracks)}</div>
								<div id="stats-tracks" class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">--</div>
							</div>
						</div>
					</div>
					<div class="bg-(--bg-secondary) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
						<div class="flex items-center gap-2 sm:gap-3">
							<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-pink-500/10 flex items-center justify-center shrink-0">
								<Icon is:inline name="material-symbols:star" class="text-[1rem] sm:text-[1.25rem] text-pink-500" />
							</div>
							<div class="min-w-0">
								<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalSubscribed)}</div>
								<div id="stats-subscribed" class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">--</div>
							</div>
						</div>
					</div>
					<div class="bg-(--bg-secondary) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
						<div class="flex items-center gap-2 sm:gap-3">
							<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-blue-500/10 flex items-center justify-center shrink-0">
								<Icon is:inline name="material-symbols:database" class="text-[1rem] sm:text-[1.25rem] text-blue-500" />
							</div>
							<div class="min-w-0">
								<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicSource)}</div>
								<div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 truncate">Netease</div>
							</div>
						</div>
					</div>
				</div>

				<div class="relative mb-4">
					<Icon is:inline name="material-symbols:search" class="absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400 w-5 h-5" />
					<input type="text" id="searchInput" placeholder={i18n(I18nKey.musicSearchPlaceholder)} class="w-full pl-10 pr-4 py-2.5 bg-(--card-bg) border border-(--line-divider) rounded-xl text-sm focus:outline-none focus:border-(--primary) focus:ring-2 focus:ring-(--primary)/20 transition-all" />
				</div>

				<div id="filterTabs" class="hidden border-b border-(--line-divider) mb-5">
					<div class="flex gap-6 overflow-x-auto">
						<button id="tab-all" onclick="setFilter('all')" class="whitespace-nowrap py-3 px-1 border-b-2 text-sm font-medium transition-colors active-tab">
							{i18n(I18nKey.musicTabAll)}
							<span id="tab-count-all" class="ml-1.5 bg-(--btn-regular-bg) text-(--btn-content) py-0.5 px-2 rounded-full text-xs">0</span>
						</button>
						<button id="tab-mine" onclick="setFilter('mine')" class="whitespace-nowrap py-3 px-1 border-b-2 text-sm font-medium transition-colors inactive-tab">
							{i18n(I18nKey.musicTabMine)}
							<span id="tab-count-mine" class="ml-1.5 bg-(--btn-regular-bg) text-(--btn-content) py-0.5 px-2 rounded-full text-xs">0</span>
						</button>
						<button id="tab-subscribed" onclick="setFilter('subscribed')" class="whitespace-nowrap py-3 px-1 border-b-2 text-sm font-medium transition-colors inactive-tab">
							{i18n(I18nKey.musicTabSubscribed)}
							<span id="tab-count-subscribed" class="ml-1.5 bg-(--btn-regular-bg) text-(--btn-content) py-0.5 px-2 rounded-full text-xs">0</span>
						</button>
					</div>
				</div>

				<input type="hidden" id="i18n-switched" value={i18n(I18nKey.musicPlaylistSwitched)} />
				<input type="hidden" id="i18n-not-loaded" value={i18n(I18nKey.musicPlayerNotLoaded)} />

				<div id="loadingState" class="text-center py-16">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
						<Icon is:inline name="material-symbols:music-note" class="text-[2rem] text-(--btn-content) animate-spin" />
					</div>
					<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
						{i18n(I18nKey.musicLoading)}
					</h2>
					<p class="text-black/60 dark:text-white/60">
						{i18n(I18nKey.musicLoadingHint)}
					</p>
				</div>

				<div id="emptyState" class="hidden text-center py-16">
					<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
						<Icon is:inline name="material-symbols:airwave-rounded" class="text-[2rem] text-(--btn-content)" />
					</div>
					<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
						{i18n(I18nKey.musicNoPlaylists)}
					</h2>
				</div>

				<div id="myPlaylistsSection" class="hidden">
					<div class="flex items-center justify-between border-b border-(--line-divider) pb-2 mb-4">
						<h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
							<Icon is:inline name="material-symbols:folder-open-rounded" class="text-base text-(--primary)" />
							{i18n(I18nKey.musicMyPlaylists)}
						</h3>
						<span id="my-count-badge" class="bg-(--btn-regular-bg) text-(--btn-content) py-0.5 px-2.5 rounded-full text-xs">0</span>
					</div>
					<div id="myPlaylistsContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3"></div>
				</div>

				<div id="subscribedPlaylistsSection" class="hidden mt-8">
					<div class="flex items-center justify-between border-b border-(--line-divider) pb-2 mb-4">
						<h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
							<Icon is:inline name="material-symbols:star" class="text-base text-pink-500" />
							{i18n(I18nKey.musicSubscribedPlaylists)}
						</h3>
						<span id="subscribed-count-badge" class="bg-(--btn-regular-bg) text-(--btn-content) py-0.5 px-2.5 rounded-full text-xs">0</span>
					</div>
					<div id="subscribedPlaylistsContainer" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3"></div>
				</div>

				<div id="playlistModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
					<div class="relative w-full max-w-lg max-h-[90vh] overflow-hidden rounded-xl sm:rounded-2xl bg-(--card-bg) border border-(--line-divider) shadow-2xl animate-in">
						<button id="modalCloseBtn" class="absolute top-4 right-4 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur-sm transition-colors hover:bg-black/70" aria-label="Close">
							<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
							</svg>
						</button>
						<div class="flex flex-col md:flex-row">
							<div class="relative w-full md:w-64 lg:w-72 shrink-0 h-48 sm:h-64 md:aspect-auto md:h-auto bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
								<img id="modalCover" src="" alt="" class="h-full w-full object-cover" />
							</div>
							<div class="flex-1 p-4 sm:p-6 overflow-y-auto max-h-[60vh] md:max-h-none custom-scrollbar">
								<h2 id="modalTitle" class="mb-1 text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100"></h2>
								<div class="mb-4 flex flex-wrap gap-2">
									<span id="modalCreatorBadge" class="inline-flex items-center gap-1 rounded-lg bg-blue-500/10 border border-blue-500/20 px-3 py-1 text-xs font-bold text-blue-600 dark:text-blue-400 hidden"></span>
									<span id="modalTrackBadge" class="inline-flex items-center gap-1 rounded-lg bg-purple-500/10 border border-purple-500/20 px-3 py-1 text-xs font-bold text-purple-600 dark:text-purple-400"></span>
									<span id="modalPlayBadge" class="inline-flex items-center gap-1 rounded-lg bg-green-500/10 border border-green-500/20 px-3 py-1 text-xs font-bold text-green-600 dark:text-green-400"></span>
								</div>
								<div id="modalDescriptionContainer" class="mb-6 hidden">
									<h3 class="mb-2 text-sm font-semibold text-neutral-700 dark:text-neutral-300">{i18n(I18nKey.musicPlaylistDesc)}</h3>
									<p id="modalDescription" class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-h-40 overflow-y-auto"></p>
								</div>
								<div class="flex gap-3">
									<button id="modalPlayBtn" class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-(--primary) px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-(--primary)/90 hover:shadow-lg">
										<svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
											<path d="M8 5v14l11-7z"/>
										</svg>
										{i18n(I18nKey.musicPlay)}
									</button>
									<a id="modalOfficialBtn" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-neutral-100 dark:bg-neutral-800 px-6 py-3 text-sm font-semibold text-neutral-700 dark:text-neutral-300 transition-all hover:bg-neutral-200 dark:hover:bg-neutral-700">
										<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
										</svg>
										{i18n(I18nKey.musicOfficialPage)}
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</>
		) : (
			<>
				{fetchFailed ? (
					<div class="text-center py-16">
						<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
							<Icon is:inline name="material-symbols:error-outline" class="text-[2rem] text-red-500" />
						</div>
						<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
							{i18n(I18nKey.musicFetchError)}
						</h2>
						<p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
							{i18n(I18nKey.musicFetchErrorDesc)}
						</p>
					</div>
				) : (
					<>
						<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
							<div class="bg-(--bg-secondary) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
								<div class="flex items-center gap-2 sm:gap-3">
									<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-(--primary)/10 flex items-center justify-center shrink-0">
										<Icon is:inline name="material-symbols:music-note" class="text-[1rem] sm:text-[1.25rem] text-(--primary)" />
									</div>
									<div class="min-w-0">
										<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalPlaylists)}</div>
										<div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">{staticPlaylists.myPlaylists.length}</div>
									</div>
								</div>
							</div>
							<div class="bg-(--bg-secondary) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
								<div class="flex items-center gap-2 sm:gap-3">
									<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-purple-500/10 flex items-center justify-center shrink-0">
										<Icon is:inline name="material-symbols:queue-music-rounded" class="text-[1rem] sm:text-[1.25rem] text-purple-500" />
									</div>
									<div class="min-w-0">
										<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalTracks)}</div>
										<div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">
											{staticPlaylists.myPlaylists.reduce((acc, p) => acc + (p.trackCount || p.tracks?.length || 0), 0)}
										</div>
									</div>
								</div>
							</div>
							<div class="bg-(--bg-secondary) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
								<div class="flex items-center gap-2 sm:gap-3">
									<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-pink-500/10 flex items-center justify-center shrink-0">
										<Icon is:inline name="material-symbols:star" class="text-[1rem] sm:text-[1.25rem] text-pink-500" />
									</div>
									<div class="min-w-0">
										<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalSubscribed)}</div>
										<div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">{staticPlaylists.subscribedPlaylists.length}</div>
									</div>
								</div>
							</div>
