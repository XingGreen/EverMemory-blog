---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18nWithTime } from "@/utils/date-utils";

if (!siteConfig.pages.music) {
	return Astro.redirect("/404/");
}

const buildTime = formatDateI18nWithTime(new Date());

const musicConfig = siteConfig.music;
const NETEASE_USER_ID = musicConfig?.userId;

const isConfigured = !!NETEASE_USER_ID;
---

<MainGridLayout title={i18n(I18nKey.music)} description={i18n(I18nKey.musicDescription)}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-4 sm:px-6 md:px-9 py-4 sm:py-6 relative w-full">
			<div class="relative w-full mb-8">
				<div class="mb-6">
					<div class="flex items-center gap-3 mb-3">
						<div class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
							<Icon is:inline name="simple-icons:neteasecloudmusic" class="text-[1.5rem]" />
						</div>
						<div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
							{i18n(I18nKey.music)}
						</div>
					</div>
					<p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed">
						{i18n(I18nKey.musicDescription)}
					</p>
					<p class="text-xs text-neutral-500 dark:text-neutral-500 mt-2">
						{i18n(I18nKey.animeLastUpdated)} {buildTime}
					</p>
				</div>

				{!isConfigured ? (
					<div class="text-center py-16">
						<div class="inline-flex items-center justify-center w-16 h-16 bg-(--btn-regular-bg) rounded-full mb-6 border border-(--line-divider)">
							<Icon is:inline name="material-symbols:settings" class="text-[2rem] text-(--btn-content)" />
						</div>
						<h2 class="text-xl font-semibold text-black/80 dark:text-white/80 mb-3">
							{i18n(I18nKey.musicNotConfigured)}
						</h2>
						<p class="text-black/60 dark:text-white/60 mb-4 max-w-md mx-auto">
							{i18n(I18nKey.musicNotConfiguredDesc)}
						</p>
					</div>
				) : (
					<>
						<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
							<div class="bg-(--card-bg) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
								<div class="flex items-center gap-2 sm:gap-3">
									<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-(--primary)/10 flex items-center justify-center shrink-0">
										<Icon is:inline name="material-symbols:music-note-rounded" class="text-[1rem] sm:text-[1.25rem] text-(--primary)" />
									</div>
									<div class="min-w-0">
										<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalPlaylists)}</div>
										<div id="stats-playlists" class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">--</div>
									</div>
								</div>
							</div>
							<div class="bg-(--card-bg) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
								<div class="flex items-center gap-2 sm:gap-3">
									<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-purple-500/10 flex items-center justify-center shrink-0">
										<Icon is:inline name="material-symbols:queue-music-rounded" class="text-[1rem] sm:text-[1.25rem] text-purple-500" />
									</div>
									<div class="min-w-0">
										<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalTracks)}</div>
										<div id="stats-tracks" class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">--</div>
									</div>
								</div>
							</div>
							<div class="bg-(--card-bg) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
								<div class="flex items-center gap-2 sm:gap-3">
									<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-pink-500/10 flex items-center justify-center shrink-0">
										<Icon is:inline name="material-symbols:star" class="text-[1rem] sm:text-[1.25rem] text-pink-500" />
									</div>
									<div class="min-w-0">
										<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicTotalSubscribed)}</div>
										<div id="stats-subscribed" class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100">--</div>
									</div>
								</div>
							</div>
							<div class="bg-(--card-bg) rounded-xl p-3 sm:p-4 border border-(--line-divider)">
								<div class="flex items-center gap-2 sm:gap-3">
									<div class="h-8 w-8 sm:h-10 sm:w-10 rounded-lg bg-blue-500/10 flex items-center justify-center shrink-0">
										<Icon is:inline name="material-symbols:database" class="text-[1rem] sm:text-[1.25rem] text-blue-500" />
									</div>
									<div class="min-w-0">
										<div class="text-[10px] sm:text-xs text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicSource)}</div>
										<div class="text-lg sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100 truncate">Netease</div>
									</div>
								</div>
							</div>
						</div>

						<div class="mb-4">
							<div class="relative">
								<svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
								</svg>
								<input
									type="text"
									id="searchInput"
									placeholder={i18n(I18nKey.musicSearch)}
									class="w-full rounded-xl border border-(--line-divider) bg-(--card-bg) py-2.5 pl-10 pr-4 text-sm text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 outline-none transition-colors focus:border-(--primary)"
								/>
							</div>
						</div>

						<div id="filterTabs" class="hidden border-b border-(--line-divider) mb-3">
							<div class="overflow-x-auto">
								<nav class="flex min-w-max space-x-8" aria-label="Tabs">
									<button id="tab-all" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors duration-200 active-tab">
										{i18n(I18nKey.all)}
									</button>
									<button id="tab-mine" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors duration-200 inactive-tab">
										{i18n(I18nKey.musicMyPlaylists)}
									</button>
									<button id="tab-subscribed" class="whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors duration-200 inactive-tab">
										{i18n(I18nKey.musicSubscribedPlaylists)}
									</button>
								</nav>
							</div>
						</div>

						<div id="loadingState" class="flex flex-col items-center justify-center py-12 text-center">
							<Icon is:inline name="material-symbols:refresh-rounded" class="text-5xl text-neutral-400 mb-4 animate-spin" aria-hidden="true" />
							<p class="text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicLoading)}</p>
							<p class="text-sm text-neutral-400 dark:text-neutral-500 mt-2">{i18n(I18nKey.musicLoadingHint)}</p>
						</div>

						<div id="emptyState" class="hidden flex flex-col items-center justify-center py-12 text-center">
							<Icon is:inline name="material-symbols:airwave-rounded" class="text-5xl text-neutral-400 mb-4" aria-hidden="true" />
							<p class="text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.musicNoPlaylists)}</p>
						</div>

						<div id="myPlaylistsSection" class="hidden">
							<h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-3 flex items-center gap-2">
								<Icon is:inline name="material-symbols:folder-open-rounded" class="text-base text-(--primary)" />
								{i18n(I18nKey.musicMyPlaylists)}
							</h3>
							<div id="myPlaylistsContainer" class="space-y-3"></div>
						</div>
						<div id="subscribedPlaylistsSection" class="hidden mt-8">
							<h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 mb-3 flex items-center gap-2">
								<Icon is:inline name="material-symbols:star" class="text-base text-pink-500" />
								{i18n(I18nKey.musicSubscribedPlaylists)}
							</h3>
							<div id="subscribedPlaylistsContainer" class="space-y-3"></div>
						</div>

						<input type="hidden" id="i18n-switched" value={i18n(I18nKey.musicPlaylistSwitched)} />
						<input type="hidden" id="i18n-not-loaded" value={i18n(I18nKey.musicPlayerNotLoaded)} />

						<div id="playlistModal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
							<div class="relative w-full max-w-lg max-h-[90vh] overflow-hidden rounded-xl sm:rounded-2xl bg-(--card-bg) border border-(--line-divider) shadow-2xl animate-in">
								<button id="modalCloseBtn" class="absolute top-4 right-4 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur-sm transition-colors hover:bg-black/70" aria-label="Close">
									<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
									</svg>
								</button>
								<div class="flex flex-col md:flex-row">
									<div class="relative w-full md:w-64 lg:w-72 shrink-0 h-48 sm:h-64 md:aspect-auto md:h-auto bg-neutral-100 dark:bg-neutral-800 overflow-hidden">
										<img id="modalCover" src="" alt="" class="h-full w-full object-cover" />
									</div>
									<div class="flex-1 p-4 sm:p-6 overflow-y-auto max-h-[60vh] md:max-h-none custom-scrollbar">
										<h2 id="modalTitle" class="mb-1 text-xl sm:text-2xl font-bold text-neutral-900 dark:text-neutral-100"></h2>
										<div class="mb-4 flex flex-wrap gap-2">
											<span id="modalCreatorBadge" class="inline-flex items-center gap-1 rounded-lg bg-blue-500/10 border border-blue-500/20 px-3 py-1 text-xs font-bold text-blue-600 dark:text-blue-400 hidden"></span>
											<span id="modalTrackBadge" class="inline-flex items-center gap-1 rounded-lg bg-purple-500/10 border border-purple-500/20 px-3 py-1 text-xs font-bold text-purple-600 dark:text-purple-400"></span>
											<span id="modalPlayBadge" class="inline-flex items-center gap-1 rounded-lg bg-green-500/10 border border-green-500/20 px-3 py-1 text-xs font-bold text-green-600 dark:text-green-400"></span>
										</div>
										<div id="modalDescriptionContainer" class="mb-6 hidden">
											<h3 class="mb-2 text-sm font-semibold text-neutral-700 dark:text-neutral-300">{i18n(I18nKey.musicPlaylistDesc)}</h3>
											<p id="modalDescription" class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed max-h-40 overflow-y-auto"></p>
										</div>
										<div class="flex gap-3">
											<button id="modalPlayBtn" class="flex-1 inline-flex items-center justify-center gap-2 rounded-xl bg-(--primary) px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-(--primary)/90 hover:shadow-lg" onclick="handleModalPlay()">
												<svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
													<path d="M8 5v14l11-7z"/>
												</svg>
												{i18n(I18nKey.musicPlay)}
											</button>
											<a id="modalOfficialBtn" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-xl bg-neutral-100 dark:bg-neutral-800 px-6 py-3 text-sm font-semibold text-neutral-700 dark:text-neutral-300 transition-all hover:bg-neutral-200 dark:hover:bg-neutral-700">
												<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
												</svg>
												{i18n(I18nKey.musicOfficialPage)}
											</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</>
				)}
			</div>
		</div>
	</div>
</MainGridLayout>

<script is:inline define:vars={{ userId: NETEASE_USER_ID }}>
(function () {
	if (!userId) return;

	const apis = [
		`https://api.i-meto.com/meting/api?server=netease&type=user&id=${userId}`,
		`https://meting.savan.link/api?server=netease&type=user&id=${userId}`,
		`https://music-api.tr1ck.xyz/api?server=netease&type=user&id=${userId}`,
		`https://apis.netstart.cn/music/user/playlist?uid=${userId}`,
	];

	const loadingState = document.getElementById('loadingState');
	const emptyState = document.getElementById('emptyState');
	const searchInput = document.getElementById('searchInput');
	const filterTabs = document.getElementById('filterTabs');
	const tabAll = document.getElementById('tab-all');
	const tabMine = document.getElementById('tab-mine');
	const tabSubscribed = document.getElementById('tab-subscribed');
	const myPlaylistsSection = document.getElementById('myPlaylistsSection');
	const myPlaylistsContainer = document.getElementById('myPlaylistsContainer');
	const subscribedPlaylistsSection = document.getElementById('subscribedPlaylistsSection');
	const subscribedPlaylistsContainer = document.getElementById('subscribedPlaylistsContainer');
	const statsPlaylists = document.getElementById('stats-playlists');
	const statsTracks = document.getElementById('stats-tracks');
	const statsSubscribed = document.getElementById('stats-subscribed');
	
	let allDetailedMyPlaylists = [];
	let allDetailedSubscribedPlaylists = [];
	let currentFilter = 'all';
	
	let modal = document.getElementById('playlistModal');
	document.body.appendChild(modal);
	
	const modalCover = document.getElementById('modalCover');
	const modalTitle = document.getElementById('modalTitle');
	const modalDescription = document.getElementById('modalDescription');
	const modalDescriptionContainer = document.getElementById('modalDescriptionContainer');
	const modalCreatorBadge = document.getElementById('modalCreatorBadge');
	const modalTrackBadge = document.getElementById('modalTrackBadge');
	const modalPlayBadge = document.getElementById('modalPlayBadge');
	const modalPlayBtn = document.getElementById('modalPlayBtn');
	const modalOfficialBtn = document.getElementById('modalOfficialBtn');
	const modalCloseBtn = document.getElementById('modalCloseBtn');
	let musicToast = document.getElementById('musicToast');
	if (!musicToast) {
		musicToast = document.createElement('div');
		musicToast.id = 'musicToast';
		musicToast.style.position = 'fixed';
		musicToast.style.left = '50%';
		musicToast.style.top = '50%';
		musicToast.style.transform = 'translate(-50%, -50%) scale(0.9)';
		musicToast.style.zIndex = '1001';
		musicToast.style.pointerEvents = 'none';
		musicToast.style.opacity = '0';
		musicToast.style.transition = 'all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
		
		const isDarkMode = document.documentElement.classList.contains('dark') || window.matchMedia('(prefers-color-scheme: dark)').matches;
		musicToast.style.background = isDarkMode 
			? 'linear-gradient(135deg, rgba(45, 55, 72, 0.95), rgba(26, 32, 44, 0.9))' 
			: 'linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(240, 248, 255, 0.9))';
		musicToast.style.color = isDarkMode ? '#e2e8f0' : '#2c3e50';
		musicToast.style.padding = '12px 20px';
		musicToast.style.borderRadius = '16px';
		musicToast.style.fontSize = '14px';
		musicToast.style.fontWeight = '500';
		musicToast.style.fontFamily = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
		musicToast.style.boxShadow = isDarkMode
			? '0 8px 32px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(0, 0, 0, 0.2)'
			: '0 8px 32px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08)';
		musicToast.style.border = isDarkMode
			? '1px solid rgba(255, 255, 255, 0.1)'
			: '1px solid rgba(255, 255, 255, 0.6)';
		musicToast.style.backdropFilter = 'blur(12px)';
		musicToast.style.textAlign = 'center';
		
		document.body.appendChild(musicToast);
	}
	
	let currentPlaylistId = null;
	let toastTimer = null;
	
	function showToast(message) {
		if (!musicToast) return;
		musicToast.textContent = message;
		musicToast.style.opacity = '1';
		musicToast.style.transform = 'translate(-50%, -50%) scale(1)';
		if (toastTimer) clearTimeout(toastTimer);
		toastTimer = setTimeout(function () {
			musicToast.style.opacity = '0';
			musicToast.style.transform = 'translate(-50%, -50%) scale(0.95)';
		}, 2500);
	}
	
	modal.addEventListener('click', function(event) {
		if (event.target === event.currentTarget) {
			closeModal();
		}
	});
	
	modalCloseBtn.addEventListener('click', closeModal);
	
	modalPlayBtn.addEventListener('click', function() {
		if (currentPlaylistId && window.__fireflyMusic) {
			window.__fireflyMusic.loadPlaylist('netease', 'playlist', currentPlaylistId);
			showToast(document.getElementById('i18n-switched').value);
		} else {
			showToast(document.getElementById('i18n-not-loaded').value);
		}
		closeModal();
	});
	
	function openModal(playlist) {
		currentPlaylistId = playlist.id;
		modalCover.src = playlist.coverImgUrl || playlist.cover || '';
		modalTitle.textContent = playlist.name;
		
		const description = playlist.description || '';
		if (description) {
			modalDescription.textContent = description;
			modalDescriptionContainer.classList.remove('hidden');
		} else {
			modalDescriptionContainer.classList.add('hidden');
		}
		
		const creator = playlist.creator?.nickname || '';
		if (creator) {
			modalCreatorBadge.textContent = creator;
			modalCreatorBadge.classList.remove('hidden');
		} else {
			modalCreatorBadge.classList.add('hidden');
		}
		
		modalTrackBadge.textContent = (playlist.trackCount || playlist.tracks?.length || 0) + ' 首';
		modalPlayBadge.textContent = formatPlays(playlist.playCount) + ' 次播放';
		modalOfficialBtn.href = 'https://music.163.com/#/playlist?id=' + playlist.id;
		
		modal.classList.remove('hidden');
	}
	
	function closeModal() {
		modal.classList.add('hidden');
		currentPlaylistId = null;
	}
	
	
	
	document.addEventListener('keydown', function(event) {
		if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
			closeModal();
		}
	});
	
	function handleSearch(e) {
		const query = e.target.value.toLowerCase().trim();
		filterPlaylists(query);
	}
	
	function setFilter(filter) {
		currentFilter = filter;
		
		const tabs = [tabAll, tabMine, tabSubscribed];
		tabs.forEach(tab => {
			tab.classList.remove('active-tab');
			tab.classList.add('inactive-tab');
		});
		
		if (filter === 'all') {
			tabAll.classList.remove('inactive-tab');
			tabAll.classList.add('active-tab');
		} else if (filter === 'mine') {
			tabMine.classList.remove('inactive-tab');
			tabMine.classList.add('active-tab');
		} else if (filter === 'subscribed') {
			tabSubscribed.classList.remove('inactive-tab');
			tabSubscribed.classList.add('active-tab');
		}
		
		const query = searchInput.value.toLowerCase().trim();
		filterPlaylists(query);
	}
	
	function filterPlaylists(query) {
		let myPlaylists = allDetailedMyPlaylists;
		let subscribedPlaylists = allDetailedSubscribedPlaylists;
		
		if (currentFilter === 'mine') {
			subscribedPlaylists = [];
		} else if (currentFilter === 'subscribed') {
			myPlaylists = [];
		}
		
		if (!query) {
			displayPlaylists(myPlaylists, subscribedPlaylists);
			return;
		}
		
		const filteredMy = myPlaylists.filter(p => 
			p.name.toLowerCase().includes(query) || 
			(p.description || '').toLowerCase().includes(query)
		);
		const filteredSubscribed = subscribedPlaylists.filter(p => 
			p.name.toLowerCase().includes(query) || 
			(p.description || '').toLowerCase().includes(query)
		);
		
		displayPlaylists(filteredMy, filteredSubscribed);
	}
	
	function displayPlaylists(myPlaylists, subscribedPlaylists) {
		myPlaylistsContainer.innerHTML = '';
		subscribedPlaylistsContainer.innerHTML = '';
		
		filterTabs.classList.remove('hidden');
		
		if (myPlaylists.length === 0 && subscribedPlaylists.length === 0) {
			myPlaylistsSection.classList.add('hidden');
			subscribedPlaylistsSection.classList.add('hidden');
			emptyState.classList.remove('hidden');
			return;
		}
		
		emptyState.classList.add('hidden');
		
		if (myPlaylists.length > 0) {
			myPlaylistsSection.classList.remove('hidden');
			myPlaylists.forEach(playlist => {
				const card = createPlaylistCard(playlist);
				myPlaylistsContainer.appendChild(card);
			});
		} else {
			myPlaylistsSection.classList.add('hidden');
		}
		
		if (subscribedPlaylists.length > 0) {
			subscribedPlaylistsSection.classList.remove('hidden');
			subscribedPlaylists.forEach(playlist => {
				const card = createPlaylistCard(playlist);
				subscribedPlaylistsContainer.appendChild(card);
			});
		} else {
			subscribedPlaylistsSection.classList.add('hidden');
		}
	}
	
	searchInput.addEventListener('input', handleSearch);
	
	tabAll.addEventListener('click', () => setFilter('all'));
	tabMine.addEventListener('click', () => setFilter('mine'));
	tabSubscribed.addEventListener('click', () => setFilter('subscribed'));

	async function fetchPlaylists() {
		const timestamp = Date.now();
		for (const url of apis) {
			try {
				const urlWithCacheBust = url + (url.includes('?') ? '&' : '?') + 't=' + timestamp;
				const response = await fetch(urlWithCacheBust, {
					headers: {
						"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
						"Referer": "https://music.163.com/",
					},
				});
				const data = await response.json();

				if (data.code === 200 && data.playlist) {
					if (data.subscribedPlaylist && Array.isArray(data.subscribedPlaylist)) {
						return {
							myPlaylists: data.playlist.filter(p => {
								const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
								return creatorId === userId.toString();
							}),
							subscribedPlaylists: data.subscribedPlaylist
						};
					}
					return {
						myPlaylists: data.playlist.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId === userId.toString();
						}),
						subscribedPlaylists: data.playlist.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId !== userId.toString();
						})
					};
				}
				if (data.code === 200 && Array.isArray(data)) {
					return {
						myPlaylists: data.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId === userId.toString();
						}),
						subscribedPlaylists: data.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId !== userId.toString();
						})
					};
				}
			} catch {
				continue;
			}
		}
		return null;
	}

	async function fetchPlaylistDetail(playlistId) {
		const timestamp = Date.now();
		const detailApis = [
			`https://api.i-meto.com/meting/api?server=netease&type=playlist&id=${playlistId}&limit=1000`,
			`https://meting.savan.link/api?server=netease&type=playlist&id=${playlistId}&limit=1000`,
			`https://music-api.tr1ck.xyz/api?server=netease&type=playlist&id=${playlistId}&limit=1000`,
		];
		for (const url of detailApis) {
			try {
				const urlWithCacheBust = url + '&t=' + timestamp;
				const response = await fetch(urlWithCacheBust, {
					headers: {
						"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
						"Referer": "https://music.163.com/",
					},
				});
				const data = await response.json();
				if (data.code === 200 && data.playlist) {
					return data.playlist;
				}
				if (data.code === 200 && data.tracks) {
					return data;
				}
				if (data.tracks && data.name) {
					return data;
				}
				if (Array.isArray(data) && data.length > 0 && data[0].tracks) {
					return data[0];
				}
			} catch {
				continue;
			}
		}
		return null;
	}

	function formatPlays(count) {
		if (count >= 10000) {
			return (count / 10000).toFixed(1) + "万";
		}
		return count;
	}

	function createSVG(iconName, className) {
		const svgNS = 'http://www.w3.org/2000/svg';
		const svg = document.createElementNS(svgNS, 'svg');
		svg.setAttribute('width', '20');
		svg.setAttribute('height', '20');
		svg.setAttribute('viewBox', '0 0 24 24');
		svg.setAttribute('fill', 'currentColor');
		svg.setAttribute('class', className || '');
		
		const path = document.createElementNS(svgNS, 'path');
		
		switch (iconName) {
			case 'music':
				path.setAttribute('d', 'M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z');
				break;
			case 'play':
				path.setAttribute('d', 'M8 5v14l11-7z');
				break;
			case 'account':
				path.setAttribute('d', 'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z');
				break;
			default:
				path.setAttribute('d', 'M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z');
		}
		
		svg.appendChild(path);
		return svg;
	}

	function createPlaylistCard(playlist) {
		const card = document.createElement('div');
		card.className = 'playlist-card card-base hover:border-(--primary)/30 hover:shadow-lg hover:shadow-(--primary)/5 transition-all duration-300 group';
		
		const coverUrl = playlist.coverImgUrl || playlist.cover || '';
		const description = playlist.description || '';
		const creator = playlist.creator?.nickname || '';

		const flexDiv = document.createElement('div');
		flexDiv.className = 'flex gap-4 p-4';
		card.appendChild(flexDiv);

		const button = document.createElement('button');
		button.className = 'relative w-24 h-24 shrink-0 rounded-lg overflow-hidden bg-neutral-100 dark:bg-neutral-800 focus:outline-none group/cover';
		button.setAttribute('data-playlist-id', playlist.id);
		button.onclick = function(e) {
			e.stopPropagation();
			if (window.__fireflyMusic) {
				window.__fireflyMusic.loadPlaylist('netease', 'playlist', this.getAttribute('data-playlist-id'));
				showToast(document.getElementById('i18n-switched').value);
			} else {
				showToast(document.getElementById('i18n-not-loaded').value);
			}
		};
		flexDiv.appendChild(button);

		const img = document.createElement('img');
		img.src = coverUrl ? coverUrl + (coverUrl.includes('?') ? '&' : '?') + 't=' + Date.now() : '';
		img.alt = playlist.name;
		img.className = 'w-full h-full object-cover transition-transform duration-500 group-hover/cover:scale-110';
		img.loading = 'lazy';
		button.appendChild(img);

		const overlay = document.createElement('div');
		overlay.className = 'absolute inset-0 bg-black/20 opacity-0 group-hover/cover:opacity-100 transition-opacity duration-300 flex items-center justify-center';
		button.appendChild(overlay);

		const playIcon = createSVG('play', 'text-3xl text-white drop-shadow-lg');
		playIcon.setAttribute('width', '48');
		playIcon.setAttribute('height', '48');
		overlay.appendChild(playIcon);

		const infoDiv = document.createElement('div');
		infoDiv.className = 'flex-1 min-w-0 flex flex-col cursor-pointer hover:text-[var(--primary)] transition-colors';
		infoDiv.onclick = function() {
			openModal(playlist);
		};
		flexDiv.appendChild(infoDiv);

		const title = document.createElement('h3');
		title.className = 'text-lg font-bold text-neutral-900 dark:text-neutral-100 truncate mb-1';
		title.textContent = playlist.name;
		infoDiv.appendChild(title);

		const desc = document.createElement('p');
		desc.className = 'text-sm text-neutral-500 dark:text-neutral-400 line-clamp-2 mb-3 flex-1';
		desc.textContent = description || '暂无简介';
		infoDiv.appendChild(desc);

		const metaDiv = document.createElement('div');
		metaDiv.className = 'flex items-center gap-4 text-xs text-neutral-400';
		infoDiv.appendChild(metaDiv);

		const trackSpan = document.createElement('span');
		trackSpan.className = 'flex items-center gap-1';
		const trackIcon = createSVG('music', 'text-base');
		trackSpan.appendChild(trackIcon);
		trackSpan.appendChild(document.createTextNode(playlist.trackCount + ' 首'));
		metaDiv.appendChild(trackSpan);

		const playSpan = document.createElement('span');
		playSpan.className = 'flex items-center gap-1';
		const playCountIcon = createSVG('play', 'text-base');
		playSpan.appendChild(playCountIcon);
		playSpan.appendChild(document.createTextNode(formatPlays(playlist.playCount) + ' 次播放'));
		metaDiv.appendChild(playSpan);

		if (creator) {
			const creatorSpan = document.createElement('span');
			creatorSpan.className = 'flex items-center gap-1';
			const creatorIcon = createSVG('account', 'text-base');
			creatorSpan.appendChild(creatorIcon);
			creatorSpan.appendChild(document.createTextNode(creator));
			metaDiv.appendChild(creatorSpan);
		}

		return card;
	}

	fetchPlaylists().then(async (result) => {
		if (!result) {
			loadingState.classList.add('hidden');
			emptyState.classList.remove('hidden');
			return;
		}

		const { myPlaylists = [], subscribedPlaylists = [] } = result;
		const allPlaylists = [...myPlaylists, ...subscribedPlaylists];
		
		if (allPlaylists.length === 0) {
			loadingState.classList.add('hidden');
			emptyState.classList.remove('hidden');
			return;
		}

		allDetailedMyPlaylists = myPlaylists.length > 0 ? await Promise.all(
			myPlaylists.map(async (playlist) => {
				const detail = await fetchPlaylistDetail(playlist.id);
				return detail || playlist;
			})
		) : [];
		
		allDetailedSubscribedPlaylists = subscribedPlaylists.length > 0 ? await Promise.all(
			subscribedPlaylists.map(async (playlist) => {
				const detail = await fetchPlaylistDetail(playlist.id);
				return detail || playlist;
			})
		) : [];
		
		const totalTracks = [...allDetailedMyPlaylists, ...allDetailedSubscribedPlaylists].reduce((sum, p) => sum + (p.trackCount || p.tracks?.length || 0), 0);
		
		statsPlaylists.textContent = allDetailedMyPlaylists.length;
		statsTracks.textContent = totalTracks;
		statsSubscribed.textContent = allDetailedSubscribedPlaylists.length;

		loadingState.classList.add('hidden');
		displayPlaylists(allDetailedMyPlaylists, allDetailedSubscribedPlaylists);
	}).catch(() => {
		loadingState.classList.add('hidden');
		emptyState.classList.remove('hidden');
	});
})();
</script>

