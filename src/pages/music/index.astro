<script is:inline define:vars={{ userId: NETEASE_USER_ID, mode: musicConfig?.mode || 'dynamic' }}>
(function () {
	if (!userId) return;
	const isDynamic = mode === 'dynamic';

	const modal = document.getElementById('playlistModal');
	if (modal) {
		document.body.appendChild(modal);
	}
	
	const modalCover = document.getElementById('modalCover');
	const modalTitle = document.getElementById('modalTitle');
	const modalDescription = document.getElementById('modalDescription');
	const modalDescriptionContainer = document.getElementById('modalDescriptionContainer');
	const modalCreatorBadge = document.getElementById('modalCreatorBadge');
	const modalTrackBadge = document.getElementById('modalTrackBadge');
	const modalPlayBadge = document.getElementById('modalPlayBadge');
	const modalPlayBtn = document.getElementById('modalPlayBtn');
	const modalOfficialBtn = document.getElementById('modalOfficialBtn');
	const modalCloseBtn = document.getElementById('modalCloseBtn');
	
	let musicToast = document.getElementById('musicToast');
	if (!musicToast) {
		musicToast = document.createElement('div');
		musicToast.id = 'musicToast';
		musicToast.style.position = 'fixed';
		musicToast.style.left = '50%';
		musicToast.style.top = '50%';
		musicToast.style.transform = 'translate(-50%, -50%) scale(0.9)';
		musicToast.style.zIndex = '1001';
		musicToast.style.pointerEvents = 'none';
		musicToast.style.opacity = '0';
		musicToast.style.transition = 'all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
		
		const isDarkMode = document.documentElement.classList.contains('dark') || window.matchMedia('(prefers-color-scheme: dark)').matches;
		musicToast.style.background = isDarkMode 
			? 'linear-gradient(135deg, rgba(45, 55, 72, 0.95), rgba(26, 32, 44, 0.9))' 
			: 'linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(240, 248, 255, 0.9))';
		musicToast.style.color = isDarkMode ? '#e2e8f0' : '#2c3e50';
		musicToast.style.padding = '12px 20px';
		musicToast.style.borderRadius = '16px';
		musicToast.style.fontSize = '14px';
		musicToast.style.fontWeight = '500';
		musicToast.style.fontFamily = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
		musicToast.style.boxShadow = isDarkMode
			? '0 8px 32px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(0, 0, 0, 0.2)'
			: '0 8px 32px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08)';
		musicToast.style.border = isDarkMode
			? '1px solid rgba(255, 255, 255, 0.1)'
			: '1px solid rgba(255, 255, 255, 0.6)';
		musicToast.style.backdropFilter = 'blur(12px)';
		musicToast.style.textAlign = 'center';
		
		document.body.appendChild(musicToast);
	}
	
	let currentPlaylistId = null;
	let toastTimer = null;
	
	function showToast(message) {
		if (!musicToast) return;
		musicToast.textContent = message;
		musicToast.style.opacity = '1';
		musicToast.style.transform = 'translate(-50%, -50%) scale(1)';
		if (toastTimer) clearTimeout(toastTimer);
		toastTimer = setTimeout(function () {
			musicToast.style.opacity = '0';
			musicToast.style.transform = 'translate(-50%, -50%) scale(0.95)';
		}, 2500);
	}
	
	function formatPlays(count) {
		if (!count) return '0';
		if (count >= 10000) {
			return (count / 10000).toFixed(1) + "万";
		}
		return count;
	}
	
	function openModal(playlist) {
		if (!modal) return;
		currentPlaylistId = playlist.id;
		modalCover.src = playlist.coverImgUrl || playlist.cover || '';
		modalTitle.textContent = playlist.name;
		
		const description = playlist.description || '';
		if (description) {
			modalDescription.textContent = description;
			modalDescriptionContainer.classList.remove('hidden');
		} else {
			modalDescriptionContainer.classList.add('hidden');
		}
		
		const creator = playlist.creator?.nickname || '';
		if (creator) {
			modalCreatorBadge.textContent = creator;
			modalCreatorBadge.classList.remove('hidden');
		} else {
			modalCreatorBadge.classList.add('hidden');
		}
		
		modalTrackBadge.textContent = (playlist.trackCount || playlist.tracks?.length || 0) + ' 首';
		modalPlayBadge.textContent = formatPlays(playlist.playCount) + ' 次播放';
		modalOfficialBtn.href = 'https://music.163.com/#/playlist?id=' + playlist.id;
		
		modal.classList.remove('hidden');
	}
	
	function openModalStatic(playlist) {
		openModal(playlist);
	}
	
	window.openModalStatic = openModalStatic;
	
	function closeModal() {
		if (!modal) return;
		modal.classList.add('hidden');
		currentPlaylistId = null;
	}
	
	if (modal) {
		modal.addEventListener('click', function(event) {
			if (event.target === event.currentTarget) {
				closeModal();
			}
		});
		
		if (modalCloseBtn) {
			modalCloseBtn.addEventListener('click', closeModal);
		}
		
		if (modalPlayBtn) {
			modalPlayBtn.addEventListener('click', function() {
				if (currentPlaylistId && window.__fireflyMusic) {
					window.__fireflyMusic.loadPlaylist('netease', 'playlist', currentPlaylistId);
					showToast(document.getElementById('i18n-switched').value);
				} else {
					showToast(document.getElementById('i18n-not-loaded').value);
				}
				closeModal();
			});
		}
		
		document.addEventListener('keydown', function(event) {
			if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
				closeModal();
			}
		});
	}
	
	if (!isDynamic) {
		document.addEventListener('DOMContentLoaded', function() {
			const staticCards = document.querySelectorAll('.static-playlist-card');
			staticCards.forEach(function(card) {
				card.addEventListener('click', function(e) {
					if (e.target.closest('button')) return;
					const playlist = {
						id: card.getAttribute('data-playlist-id'),
						name: card.getAttribute('data-playlist-name'),
						coverImgUrl: card.getAttribute('data-playlist-cover'),
						description: card.getAttribute('data-playlist-desc'),
						creator: { nickname: card.getAttribute('data-playlist-creator') },
						trackCount: parseInt(card.getAttribute('data-playlist-tracks') || '0'),
						playCount: parseInt(card.getAttribute('data-playlist-plays') || '0')
					};
					openModalStatic(playlist);
				});
			});
		});
		return;
	}

	function initDynamic() {
	const apis = [
		`https://apis.netstart.cn/music/user/playlist?uid=${userId}`,
		`https://api.i-meto.com/meting/api?server=netease&type=playlist&id=${userId}`,
	];

	const loadingState = document.getElementById('loadingState');
	const emptyState = document.getElementById('emptyState');
	const searchInput = document.getElementById('searchInput');
	const filterTabs = document.getElementById('filterTabs');
	const tabAll = document.getElementById('tab-all');
	const tabMine = document.getElementById('tab-mine');
	const tabSubscribed = document.getElementById('tab-subscribed');
	const myPlaylistsSection = document.getElementById('myPlaylistsSection');
	const myPlaylistsContainer = document.getElementById('myPlaylistsContainer');
	const subscribedPlaylistsSection = document.getElementById('subscribedPlaylistsSection');
	const subscribedPlaylistsContainer = document.getElementById('subscribedPlaylistsContainer');
	const statsPlaylists = document.getElementById('stats-playlists');
	const statsTracks = document.getElementById('stats-tracks');
	const statsSubscribed = document.getElementById('stats-subscribed');
	const myCountBadge = document.getElementById('my-count-badge');
	const subscribedCountBadge = document.getElementById('subscribed-count-badge');
	const tabCountAll = document.getElementById('tab-count-all');
	const tabCountMine = document.getElementById('tab-count-mine');
	const tabCountSubscribed = document.getElementById('tab-count-subscribed');
	
	let allDetailedMyPlaylists = [];
	let allDetailedSubscribedPlaylists = [];
	let currentFilter = 'all';
	const CONCURRENCY = 4; // 歌单详情最大并发数，避免一次性向第三方代理打出大量请求
	// localStorage 缓存：再次进入页面时秒出渲染，避免每次等待第三方代理回源
	const CACHE_KEY = 'music-playlist-data-' + userId;
	const CACHE_TTL = 10 * 60 * 1000; // 缓存有效期 10 分钟

	// 带超时的 fetch：第三方代理挂起时自动中断，快速 fallthrough 到备用 API
	async function fetchWithTimeout(url, options, timeoutMs = 10000) {
		const controller = new AbortController();
		const timer = setTimeout(() => controller.abort(), timeoutMs);
		try {
			const response = await fetch(url, { ...options, signal: controller.signal });
			clearTimeout(timer);
			return response;
		} catch (error) {
			clearTimeout(timer);
			throw error;
		}
	}

	// 并发受限的 map：替代 Promise.all，控制同时进行的详情请求数量
	async function mapWithConcurrency(items, concurrency, mapper) {
		const results = new Array(items.length);
		let next = 0;
		async function worker() {
			while (next < items.length) {
				const index = next++;
				results[index] = await mapper(items[index], index);
			}
		}
		await Promise.all(
			Array.from({ length: Math.min(concurrency, items.length) }, worker)
		);
		return results;
	}

	function readCache(ignoreTtl = false) {
		try {
			const raw = localStorage.getItem(CACHE_KEY);
			if (!raw) return null;
			const parsed = JSON.parse(raw);
			if (!parsed || typeof parsed.savedAt !== 'number' || !parsed.data) return null;
			if (!ignoreTtl && Date.now() - parsed.savedAt > CACHE_TTL) return null;
			return parsed.data;
		} catch {
			return null;
		}
	}

	function writeCache(data) {
		try {
			localStorage.setItem(CACHE_KEY, JSON.stringify({ savedAt: Date.now(), data }));
		} catch {
			// 隐私模式等场景下 localStorage 不可用，忽略即可
		}
	}

	function handleSearch(e) {
		const query = e.target.value.toLowerCase().trim();
		filterPlaylists(query);
	}

	function setFilter(filter) {
		currentFilter = filter;
		
		const tabs = [tabAll, tabMine, tabSubscribed];
		tabs.forEach(tab => {
			tab.classList.remove('active-tab');
			tab.classList.add('inactive-tab');
		});
		
		if (filter === 'all') {
			tabAll.classList.remove('inactive-tab');
			tabAll.classList.add('active-tab');
		} else if (filter === 'mine') {
			tabMine.classList.remove('inactive-tab');
			tabMine.classList.add('active-tab');
		} else if (filter === 'subscribed') {
			tabSubscribed.classList.remove('inactive-tab');
			tabSubscribed.classList.add('active-tab');
		}
		
		const query = searchInput.value.toLowerCase().trim();
		filterPlaylists(query);
	}

	function filterPlaylists(query) {
		let myPlaylists = allDetailedMyPlaylists;
		let subscribedPlaylists = allDetailedSubscribedPlaylists;
		
		if (currentFilter === 'mine') {
			subscribedPlaylists = [];
		} else if (currentFilter === 'subscribed') {
			myPlaylists = [];
		}
		
		if (!query) {
			displayPlaylists(myPlaylists, subscribedPlaylists);
			return;
		}
		
		const filteredMy = myPlaylists.filter(p => 
			p.name.toLowerCase().includes(query) || 
			(p.description || '').toLowerCase().includes(query)
		);
		const filteredSubscribed = subscribedPlaylists.filter(p => 
			p.name.toLowerCase().includes(query) || 
			(p.description || '').toLowerCase().includes(query)
		);
		
		displayPlaylists(filteredMy, filteredSubscribed);
	}

	function displayPlaylists(myPlaylists, subscribedPlaylists) {
		myPlaylistsContainer.innerHTML = '';
		subscribedPlaylistsContainer.innerHTML = '';
		
		filterTabs.classList.remove('hidden');
		
		if (myPlaylists.length === 0 && subscribedPlaylists.length === 0) {
			myPlaylistsSection.classList.add('hidden');
			subscribedPlaylistsSection.classList.add('hidden');
			emptyState.classList.remove('hidden');
			return;
		}
		
		emptyState.classList.add('hidden');
		
		if (myPlaylists.length > 0) {
			myPlaylistsSection.classList.remove('hidden');
			myPlaylists.forEach(playlist => {
				const card = createPlaylistCard(playlist);
				myPlaylistsContainer.appendChild(card);
			});
		} else {
			myPlaylistsSection.classList.add('hidden');
		}
		
		if (subscribedPlaylists.length > 0) {
			subscribedPlaylistsSection.classList.remove('hidden');
			subscribedPlaylists.forEach(playlist => {
				const card = createPlaylistCard(playlist);
				subscribedPlaylistsContainer.appendChild(card);
			});
		} else {
			subscribedPlaylistsSection.classList.add('hidden');
		}
	}

	searchInput.addEventListener('input', handleSearch);

	tabAll.addEventListener('click', () => setFilter('all'));
	tabMine.addEventListener('click', () => setFilter('mine'));
	tabSubscribed.addEventListener('click', () => setFilter('subscribed'));

	async function fetchPlaylists() {
		if (!userId) {
			return null;
		}
		const userIdStr = userId.toString();
		const timestamp = Date.now();
		for (const url of apis) {
			try {
				const urlWithCacheBust = url + (url.includes('?') ? '&' : '?') + 't=' + timestamp;
				const response = await fetchWithTimeout(urlWithCacheBust, {
					headers: {
						"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
						"Referer": "https://music.163.com/",
					},
				});
				const data = await response.json();

				if (data.code === 200 && data.playlist) {
					if (data.subscribedPlaylist && Array.isArray(data.subscribedPlaylist)) {
						return {
							myPlaylists: data.playlist.filter(p => {
								const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
								return creatorId === userIdStr;
							}),
							subscribedPlaylists: data.subscribedPlaylist
						};
					}
					return {
						myPlaylists: data.playlist.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId === userIdStr;
						}),
						subscribedPlaylists: data.playlist.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId !== userIdStr;
						})
					};
				}
				if (data.code === 200 && Array.isArray(data)) {
					return {
						myPlaylists: data.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId === userIdStr;
						}),
						subscribedPlaylists: data.filter(p => {
							const creatorId = p.creator?.userId?.toString() || p.creator?.id?.toString();
							return creatorId !== userIdStr;
						})
					};
				}
			} catch {
				continue;
			}
		}
		return null;
	}

	async function fetchPlaylistDetail(playlistId) {
		const timestamp = Date.now();
		const detailApis = [
			`https://api.i-meto.com/meting/api?server=netease&type=playlist&id=${playlistId}&limit=300`,
		];
		for (const url of detailApis) {
			try {
				const urlWithCacheBust = url + '&t=' + timestamp;
				const response = await fetchWithTimeout(urlWithCacheBust, {
					headers: {
						"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
						"Referer": "https://music.163.com/",
					},
				});
				const data = await response.json();
				if (data.code === 200 && data.playlist) {
					return data.playlist;
				}
				if (data.code === 200 && data.tracks) {
					return data;
				}
				if (data.tracks && data.name) {
					return data;
				}
				if (Array.isArray(data) && data.length > 0 && data[0].tracks) {
					return data[0];
				}
			} catch {
				continue;
			}
		}
		return null;
	}

	function createSVG(iconName, className) {
		const svgNS = 'http://www.w3.org/2000/svg';
		const svg = document.createElementNS(svgNS, 'svg');
		svg.setAttribute('width', '20');
		svg.setAttribute('height', '20');
		svg.setAttribute('viewBox', '0 0 24 24');
		svg.setAttribute('fill', 'currentColor');
		svg.setAttribute('class', className || '');
		
		const path = document.createElementNS(svgNS, 'path');
		
		switch (iconName) {
			case 'music':
				path.setAttribute('d', 'M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z');
				break;
			case 'play':
				path.setAttribute('d', 'M8 5v14l11-7z');
				break;
			case 'account':
				path.setAttribute('d', 'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z');
				break;
			default:
				path.setAttribute('d', 'M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z');
		}
		
		svg.appendChild(path);
		return svg;
	}

	function createPlaylistCard(playlist) {
		const card = document.createElement('div');
		card.className = 'playlist-card group relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg hover:scale-[1.02] cursor-pointer';

		const coverUrl = playlist.coverImgUrl || playlist.cover || '';
		const creator = playlist.creator?.nickname || '';

		const wrap = document.createElement('div');
		wrap.className = 'aspect-square relative overflow-hidden';
		card.appendChild(wrap);

		const img = document.createElement('img');
		img.src = coverUrl ? coverUrl + (coverUrl.includes('?') ? '&' : '?') + 't=' + Date.now() : '';
		img.alt = playlist.name;
		img.className = 'w-full h-full object-cover transition-transform duration-500 group-hover:scale-105';
		img.loading = 'lazy';
		wrap.appendChild(img);

		const gradient = document.createElement('div');
		gradient.className = 'absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent pointer-events-none';
		wrap.appendChild(gradient);

		// 悬停播放按钮
		const playOverlay = document.createElement('div');
		playOverlay.className = 'absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none';
		wrap.appendChild(playOverlay);

		const playBtn = document.createElement('button');
		playBtn.type = 'button';
		playBtn.className = 'pointer-events-auto flex h-11 w-11 items-center justify-center rounded-full bg-white/25 text-white backdrop-blur-sm transition-colors hover:bg-white/40';
		playBtn.onclick = function(e) {
			e.stopPropagation();
			if (window.__fireflyMusic) {
				window.__fireflyMusic.loadPlaylist('netease', 'playlist', playlist.id);
				showToast(document.getElementById('i18n-switched').value);
			} else {
				showToast(document.getElementById('i18n-not-loaded').value);
			}
		};
		const playIcon = createSVG('play', '');
		playIcon.setAttribute('width', '20');
		playIcon.setAttribute('height', '20');
		playBtn.appendChild(playIcon);
		playOverlay.appendChild(playBtn);

		// 曲目数徽标
		const trackBadge = document.createElement('span');
		trackBadge.className = 'absolute top-2 right-2 inline-flex items-center gap-1 rounded-full bg-black/50 px-2 py-0.5 text-xs font-medium text-white backdrop-blur-sm';
		const noteIcon = createSVG('music', '');
		noteIcon.setAttribute('width', '12');
		noteIcon.setAttribute('height', '12');
		trackBadge.appendChild(noteIcon);
		trackBadge.appendChild(document.createTextNode((playlist.trackCount || playlist.tracks?.length || 0) + ' 首'));
		wrap.appendChild(trackBadge);

		// 底部信息（渐变上）
		const info = document.createElement('div');
		info.className = 'absolute bottom-0 left-0 right-0 p-3';
		wrap.appendChild(info);

		const title = document.createElement('h3');
		title.className = 'text-sm font-bold text-white line-clamp-2 drop-shadow-lg';
		title.textContent = playlist.name;
		info.appendChild(title);

		const meta = document.createElement('div');
		meta.className = 'mt-1 flex items-center gap-3 text-xs text-white/70';
		info.appendChild(meta);

		const playSpan = document.createElement('span');
		playSpan.className = 'inline-flex items-center gap-1';
		const playCountIcon = createSVG('play', '');
		playCountIcon.setAttribute('width', '12');
		playCountIcon.setAttribute('height', '12');
		playSpan.appendChild(playCountIcon);
		playSpan.appendChild(document.createTextNode(formatPlays(playlist.playCount) + ' 次播放'));
		meta.appendChild(playSpan);

		if (creator) {
			const creatorSpan = document.createElement('span');
			creatorSpan.className = 'inline-flex items-center gap-1 truncate';
			const creatorIcon = createSVG('account', '');
			creatorIcon.setAttribute('width', '12');
			creatorIcon.setAttribute('height', '12');
			creatorSpan.appendChild(creatorIcon);
			creatorSpan.appendChild(document.createTextNode(creator));
			meta.appendChild(creatorSpan);
		}

		card.onclick = function() {
			openModal(playlist);
		};

		return card;
	}

			function applyPlaylistData({ my, subscribed }) {
				allDetailedMyPlaylists = my;
				allDetailedSubscribedPlaylists = subscribed;

				// 同步标签页与分区头的计数徽标
				if (myCountBadge) myCountBadge.textContent = my.length;
				if (subscribedCountBadge) subscribedCountBadge.textContent = subscribed.length;
				if (tabCountAll) tabCountAll.textContent = my.length + subscribed.length;
				if (tabCountMine) tabCountMine.textContent = my.length;
				if (tabCountSubscribed) tabCountSubscribed.textContent = subscribed.length;

				const totalTracks = [...my, ...subscribed].reduce((sum, p) => sum + (p.trackCount || p.tracks?.length || 0), 0);

				statsPlaylists.textContent = my.length;
				statsTracks.textContent = totalTracks;
				statsSubscribed.textContent = subscribed.length;

				loadingState.classList.add('hidden');
				displayPlaylists(my, subscribed);

				const updateTimeEl = document.getElementById('updateTime');
				if (updateTimeEl) {
					const now = new Date();
					const timeStr = now.toLocaleString('zh-CN', {
						month: '2-digit',
						day: '2-digit',
						hour: '2-digit',
						minute: '2-digit'
					});
					updateTimeEl.innerHTML = '| 更新时间 ' + timeStr;
				}
			}

			// 从网络加载并渲染，成功后写入缓存；失败时回退到过期缓存，仍无则显示空态
			async function loadData() {
				try {
					const result = await fetchPlaylists();
					if (!result) throw new Error('no data');

					const { myPlaylists = [], subscribedPlaylists = [] } = result;
					const allPlaylists = [...myPlaylists, ...subscribedPlaylists];
					if (allPlaylists.length === 0) throw new Error('empty');

					// 详情并发受限获取；列表接口的 trackCount 更可靠，详情仅作补充，
					// 避免 limit 截断后把真实数量覆盖成 300
					const enrich = async (playlist) => {
						const detail = await fetchPlaylistDetail(playlist.id);
						if (!detail) return playlist;
						return {
							...playlist,
							...detail,
							trackCount: playlist.trackCount || detail.trackCount || detail.tracks?.length || 0,
						};
					};

					const [my, subscribed] = await Promise.all([
						myPlaylists.length > 0
							? mapWithConcurrency(myPlaylists, CONCURRENCY, enrich)
							: Promise.resolve([]),
						subscribedPlaylists.length > 0
							? mapWithConcurrency(subscribedPlaylists, CONCURRENCY, enrich)
							: Promise.resolve([]),
					]);

					writeCache({ my, subscribed });
					applyPlaylistData({ my, subscribed });
				} catch (error) {
					// 网络失败或数据为空时，回退到过期缓存，避免页面白等后一片空白
					const stale = readCache(true);
					if (stale) {
						applyPlaylistData({ my: stale.my, subscribed: stale.subscribed });
						return;
					}
					loadingState.classList.add('hidden');
					emptyState.classList.remove('hidden');
				}
			}

			// 缓存命中：立即用缓存渲染，再后台静默刷新，保证页面快速可见
			const cached = readCache();
			if (cached) {
				applyPlaylistData({ my: cached.my, subscribed: cached.subscribed });
			}
			loadData();
	}
	
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initDynamic);
	} else {
		initDynamic();
	}
})();
	</script>

