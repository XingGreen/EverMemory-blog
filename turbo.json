{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "icons": {
      "inputs": [
        "src/**/*.svelte",
        "src/**/*.astro",
        "src/**/*.ts",
        "src/**/*.js",
        "scripts/generate-icons.js"
      ],
      "outputs": ["src/constants/icons.ts"]
    },
    "lqips": {
      "inputs": [
        "src/**/*.{png,jpg,jpeg,webp,avif}",
        "public/**/*.{png,jpg,jpeg,webp,avif}",
        "!public/favicon/**",
        "!public/pio/**",
        "!public/assets/images/effects/**",
        "!public/assets/music/**",
        "scripts/generate-lqips.ts"
      ],
      "outputs": ["src/constants/lqips.json"]
    },
    "snapshot": {
      "inputs": [
        "src/config/**",
        "src/types/**",
        "src/content.config.ts",
        "scripts/generate-config-snapshot.ts"
      ],
      "outputs": ["src/constants/admin-config-snapshot.ts"]
    },
    "github-cards": {
      "inputs": [
        "src/content/**/*.md",
        "src/content/**/*.mdx",
        "src/constants/github-card-data.json",
        "src/utils/github-card-utils.ts",
        "scripts/generate-github-card-data.ts"
      ],
      "outputs": ["src/constants/github-card-data.json"],
      "env": ["GITHUB_TOKEN"]
    },
    "taxonomy-check": {
      "inputs": [
        "src/content/**/*.md",
        "src/content/**/*.mdx",
        "src/content/taxonomy.json",
        "scripts/validate-taxonomy.ts"
      ]
    },
    "astro-build": {
      "dependsOn": ["icons", "lqips", "github-cards", "snapshot", "taxonomy-check"],
      "cache": false,
      "env": ["CF_WORKERS", "VERCEL", "BASE_PATH"]
    },
    "subset-fonts": {
      "dependsOn": ["astro-build"],
      "cache": false
    },
    "pagefind": {
      "dependsOn": ["astro-build", "subset-fonts"],
      "cache": false
    }
  }
}