{
	// Cloudflare Workers 部署配置。
	// 结构与 @astrojs/cloudflare 产出的 dist/server/wrangler.json 对齐：
	// 该文件由适配器在构建时生成，是「合并后的完整配置」，这里保持同源，
	// 避免 wrangler 直接读根配置时少了 rules/no_bundle 而把 ESM 产物误判成
	// Service Worker 格式（会报 "no default export" + 一串 node: external 错误）。
	"name": "firefly",
	"main": "./dist/server/entry.mjs",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],

	// 适配器已 bundle 过产物（entry.mjs + chunks），wrangler 不再二次打包。
	"no_bundle": true,
	// 产物是 ESM（.mjs/.js），显式声明避免被当成旧式 Worker。
	"rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],

	// 静态资源：v14 产物把页面放在 dist/client（不是 dist 根）。
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},

	// 会话：Astro sessions + 后台会话表走 KV。
	// id 必须由 `npx wrangler kv namespace create SESSION` 生成后填入，占位值无法部署。
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "REPLACE_WITH_SESSION_KV_NAMESPACE_ID"
		}
	],

	// 图片：适配器会自动接管 astro:assets（见构建日志的 IMAGES binding），
	// 需在 Cloudflare 后台开通 Images（有免费额度）。
	"images": {
		"binding": "IMAGES"
	}
}
